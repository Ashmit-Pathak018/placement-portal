<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — CampusPlace</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container">
    <%- include('../partials/flash') %>
    
    <h1>Admin Dashboard</h1>

    <div class="stats-grid">
      <div class="stat-card">
        <h3>Pending Companies</h3>
        <p class="stat-number"><%= stats.pendingCompanies %></p>
        <a href="/admin/companies/pending">Review Companies</a>
      </div>
      <div class="stat-card">
        <h3>Pending Postings</h3>
        <p class="stat-number"><%= stats.pendingPostings %></p>
        <a href="/admin/postings/pending">Review Postings</a>
      </div>
      <div class="stat-card">
        <h3>Total Applications</h3>
        <p class="stat-number"><%= stats.totalApplications %></p>
      </div>
      <div class="stat-card">
        <h3>Total Students</h3>
        <p class="stat-number"><%= stats.totalStudents %></p>
      </div>
    </div>

    <div class="charts-grid">
      <div class="chart-container">
        <h3>Placements by Branch</h3>
        <canvas id="placementsChart"></canvas>
      </div>
      <div class="chart-container">
        <h3>Applications Per Company</h3>
        <canvas id="appsPerCompanyChart"></canvas>
      </div>
      <div class="chart-container">
        <h3>Average CGPA of Offered Students</h3>
        <canvas id="avgCgpaChart"></canvas>
      </div>
    </div>

    <script>
      const chartsData = <%- JSON.stringify(charts) %>;

      // Placements by Branch
      new Chart(document.getElementById('placementsChart'), {
        type: 'bar',
        data: {
          labels: chartsData.placementsByBranch.map(d => d.branch),
          datasets: [{
            label: 'Offered Students',
            data: chartsData.placementsByBranch.map(d => d.count),
            backgroundColor: 'rgba(54, 162, 235, 0.5)'
          }]
        }
      });

      // Applications Per Company
      new Chart(document.getElementById('appsPerCompanyChart'), {
        type: 'bar',
        data: {
          labels: chartsData.applicationsPerCompany.map(d => d.company),
          datasets: [{
            label: 'Applications',
            data: chartsData.applicationsPerCompany.map(d => d.count),
            backgroundColor: 'rgba(255, 99, 132, 0.5)'
          }]
        },
        options: {
          indexAxis: 'y'
        }
      });

      // Average CGPA
      new Chart(document.getElementById('avgCgpaChart'), {
        type: 'bar',
        data: {
          labels: chartsData.avgCgpaByBranch.map(d => d.branch),
          datasets: [{
            label: 'Average CGPA',
            data: chartsData.avgCgpaByBranch.map(d => d.avgCgpa),
            backgroundColor: 'rgba(75, 192, 192, 0.5)'
          }]
        }
      });
    </script>
    
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
