<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col page-bg text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <div>
      <a href="/admin/dashboard" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
        <i class="ph-bold ph-arrow-left w-3.5 h-3.5"></i>
        Back to Admin Overview
      </a>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Pending Company Authorizations</h1>
        <p class="text-xs text-slate-500 mt-1">Verify recruiter identities and approve organization profiles before they can publish campus job drives.</p>
      </div>
      <span class="badge badge-pending text-xs py-1 px-3 self-start sm:self-auto">
        <span class="badge-dot"></span>
        <%= companies ? companies.length : 0 %> awaiting review
      </span>
    </div>

    <!-- Companies Queue -->
    <% if (companies && companies.length > 0) { %>
      <div class="space-y-4">
        <% companies.forEach(company => { %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-6">
            
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-4 border-b border-slate-100">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center font-bold text-lg shrink-0">
                  <%= company.name.substring(0, 2).toUpperCase() %>
                </div>
                <div>
                  <h3 class="text-lg font-bold text-slate-900"><%= company.name %></h3>
                  <div class="text-xs text-slate-500 flex items-center gap-3 flex-wrap mt-0.5">
                    <span>Recruiter: <strong class="text-slate-700"><%= company.recruiter_email %></strong></span>
                    <% if (company.website) { %>
                      <span>&bull;</span>
                      <a href="<%= company.website %>" target="_blank" class="text-brand-600 hover:underline flex items-center gap-1">
                        <%= company.website %>
                        <i class="ph-bold ph-arrow-square-out w-3 h-3"></i>
                      </a>
                    <% } %>
                  </div>
                </div>
              </div>

              <span class="text-xs text-slate-400 whitespace-nowrap">
                Submitted on <%= new Date(company.created_at).toLocaleDateString() %>
              </span>
            </div>

            <!-- Description -->
            <div class="text-xs text-slate-600 leading-relaxed">
              <%= company.description || 'No description provided.' %>
            </div>

            <!-- Review Actions Area -->
            <div class="pt-4 border-t border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-50 -mx-6 -mb-6 p-6 sm:-mx-8 sm:-mb-8 sm:p-6 rounded-b-2xl">
              <div class="text-xs text-slate-500 flex items-center gap-1.5">
                <i class="ph-bold ph-shield w-4 h-4 text-brand-600"></i>
                <span>Decision will be recorded transactionally in the placement audit logs.</span>
              </div>

              <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                
                <!-- Approve Form -->
                <form action="/admin/companies/<%= company.id %>/review" method="POST" class="flex items-center gap-2 m-0">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="approved">
                  <input type="hidden" name="reason" value="Verified credentials">
                  <button type="submit"
                    class="w-full sm:w-auto px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition-colors flex items-center justify-center gap-1.5">
                    <i class="ph-bold ph-check w-3.5 h-3.5"></i>
                    Approve Organization
                  </button>
                </form>

                <!-- Reject Form (with reason) -->
                <form action="/admin/companies/<%= company.id %>/review" method="POST" class="flex items-center gap-2 m-0">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="rejected">
                  <input type="text" name="reason" placeholder="Reason for rejection..." required
                    class="px-3 py-1.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-rose-500 w-48">
                  <button type="submit"
                    class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold shadow-xs transition-colors flex items-center gap-1.5 whitespace-nowrap">
                    <i class="ph-bold ph-x w-3.5 h-3.5"></i>
                    Reject
                  </button>
                </form>

              </div>
            </div>

          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto">
          <i class="ph-bold ph-checks w-6 h-6"></i>
        </div>
        <h3 class="text-base font-bold text-slate-900">Queue is Clear</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">There are currently no recruiter company registration requests awaiting review.</p>
        <div>
          <a href="/admin/dashboard" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            Back to Dashboard
          </a>
        </div>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
