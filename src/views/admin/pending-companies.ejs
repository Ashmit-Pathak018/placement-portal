<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — CampusPlace</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container">
    <%- include('../partials/flash') %>
    
    <h1>Pending Companies</h1>

    <% if (companies.length === 0) { %>
      <p>No pending companies at the moment.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Company Name</th>
            <th>Recruiter Email</th>
            <th>Website</th>
            <th>Registered At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% companies.forEach(company => { %>
            <tr>
              <td><%= company.name %></td>
              <td><%= company.recruiter_email %></td>
              <td><a href="<%= company.website %>" target="_blank"><%= company.website %></a></td>
              <td><%= new Date(company.created_at).toLocaleString() %></td>
              <td>
                <form action="/admin/companies/<%= company.id %>/review" method="POST" style="display:inline-block;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="approved">
                  <input type="text" name="reason" placeholder="Reason (optional)" class="form-control-sm">
                  <button type="submit" class="btn btn-success btn-sm">Approve</button>
                </form>
                
                <form action="/admin/companies/<%= company.id %>/review" method="POST" style="display:inline-block; margin-top: 5px;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="rejected">
                  <input type="text" name="reason" placeholder="Reason (required for rejection)" required class="form-control-sm">
                  <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

  </main>
  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
