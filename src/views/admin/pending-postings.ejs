<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <div>
      <a href="/admin/dashboard" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
        Back to Admin Overview
      </a>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Job & Internship Posting Authorization</h1>
        <p class="text-xs text-slate-500 mt-1">Review recruiter criteria, verify department suitability, and authorize public student application access.</p>
      </div>
      <span class="badge badge-pending text-xs py-1 px-3 self-start sm:self-auto">
        <span class="badge-dot"></span>
        <%= postings ? postings.length : 0 %> awaiting review
      </span>
    </div>

    <!-- Postings Queue -->
    <% if (postings && postings.length > 0) { %>
      <div class="space-y-4">
        <% postings.forEach(posting => { %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-6">
            
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-4 border-b border-slate-100">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="badge <%= (posting.type || posting.job_type) === 'job' ? 'badge-job' : 'badge-internship' %>">
                    <%= posting.type || posting.job_type %>
                  </span>
                  <span class="text-xs font-semibold text-slate-500 flex items-center gap-1">
                    <i data-lucide="building-2" class="w-3.5 h-3.5 text-slate-400"></i>
                    <%= posting.company_name %>
                  </span>
                </div>
                <h3 class="text-lg font-bold text-slate-900"><%= posting.title %></h3>
              </div>

              <div class="text-xs text-slate-400 whitespace-nowrap">
                Deadline: <strong class="text-rose-600"><%= new Date(posting.deadline).toLocaleDateString() %></strong>
              </div>
            </div>

            <!-- Role Specs & Criteria Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
              <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-0.5">
                <span class="text-slate-500 block">Min CGPA Cutoff</span>
                <span class="font-bold text-slate-900 text-sm"><%= posting.min_cgpa %></span>
              </div>
              <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-0.5">
                <span class="text-slate-500 block">Target Batch Year</span>
                <span class="font-bold text-slate-900 text-sm"><%= posting.grad_year || 'Open Batch' %></span>
              </div>
              <div class="sm:col-span-2 p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-0.5">
                <span class="text-slate-500 block">Eligible Departments</span>
                <span class="font-bold text-slate-900"><%= posting.eligible_branches || 'All' %></span>
              </div>
            </div>

            <% if (posting.description) { %>
              <div class="text-xs text-slate-600 leading-relaxed bg-slate-50/50 p-4 rounded-xl border border-slate-100">
                <span class="font-semibold text-slate-700 block mb-1">Description:</span>
                <%= posting.description %>
              </div>
            <% } %>

            <!-- Review Actions Area -->
            <div class="pt-4 border-t border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-50 -mx-6 -mb-6 p-6 sm:-mx-8 sm:-mb-8 sm:p-6 rounded-b-2xl">
              <div class="text-xs text-slate-500 flex items-center gap-1.5">
                <i data-lucide="shield-check" class="w-4 h-4 text-brand-600"></i>
                <span>Approval will immediately open this role for student eligibility checks.</span>
              </div>

              <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                
                <!-- Approve Form -->
                <form action="/admin/postings/<%= posting.id %>/review" method="POST" class="flex items-center gap-2 m-0">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="approved">
                  <input type="hidden" name="reason" value="Authorized by placement cell">
                  <button type="submit"
                    class="w-full sm:w-auto px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition-colors flex items-center justify-center gap-1.5">
                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                    Authorize Posting
                  </button>
                </form>

                <!-- Reject Form -->
                <form action="/admin/postings/<%= posting.id %>/review" method="POST" class="flex items-center gap-2 m-0">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="rejected">
                  <input type="text" name="reason" placeholder="Rejection reason..." required
                    class="px-3 py-1.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-rose-500 w-48">
                  <button type="submit"
                    class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold shadow-xs transition-colors flex items-center gap-1.5 whitespace-nowrap">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                    Reject
                  </button>
                </form>

              </div>
            </div>

          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto">
          <i data-lucide="check-check" class="w-6 h-6"></i>
        </div>
        <h3 class="text-base font-bold text-slate-900">Postings Queue is Clear</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">There are currently no job postings waiting for administrative review.</p>
        <div>
          <a href="/admin/dashboard" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            Back to Dashboard
          </a>
        </div>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
