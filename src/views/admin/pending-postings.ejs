<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — CampusPlace</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container">
    <%- include('../partials/flash') %>
    
    <h1>Pending Postings</h1>

    <% if (postings.length === 0) { %>
      <p>No pending postings at the moment.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Company</th>
            <th>Type</th>
            <th>Min CGPA</th>
            <th>Deadline</th>
            <th>Eligible Branches</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% postings.forEach(posting => { %>
            <tr>
              <td><%= posting.title %></td>
              <td><%= posting.company_name %></td>
              <td><%= posting.job_type %></td>
              <td><%= posting.min_cgpa %></td>
              <td><%= new Date(posting.deadline).toLocaleDateString() %></td>
              <td><%= posting.eligible_branches %></td>
              <td>
                <form action="/admin/postings/<%= posting.id %>/review" method="POST" style="display:inline-block; margin-bottom: 5px;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="approved">
                  <input type="text" name="reason" placeholder="Reason (optional)" class="form-control-sm">
                  <button type="submit" class="btn btn-success btn-sm">Approve</button>
                </form>
                
                <form action="/admin/postings/<%= posting.id %>/review" method="POST" style="display:inline-block;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="rejected">
                  <input type="text" name="reason" placeholder="Reason (required for rejection)" required class="form-control-sm">
                  <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

  </main>
  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
