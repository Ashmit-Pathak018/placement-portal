<%- include('../layouts/main', { body: `
<div class="auth-container">
  <h1>Login</h1>
  <form action="/login" method="POST" class="form">
    <input type="hidden" name="_csrf" value="${csrfToken}">
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required class="form-control" placeholder="you@example.com">
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required class="form-control" placeholder="••••••">
    </div>
    <button type="submit" class="btn btn-primary btn-block">Log In</button>
  </form>
  <p class="text-center mt-1">Don't have an account? <a href="/register">Register here</a></p>
</div>
` }) %>
