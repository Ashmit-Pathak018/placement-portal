<%- include('../layouts/main', { body: `
<div class="auth-container">
  <h1>Register</h1>
  <form action="/register" method="POST" class="form">
    <input type="hidden" name="_csrf" value="${csrfToken}">
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required class="form-control" placeholder="you@example.com">
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required minlength="6" class="form-control" placeholder="Min 6 characters">
    </div>
    <div class="form-group">
      <label for="role">I am a</label>
      <select id="role" name="role" required class="form-control">
        <option value="student">Student</option>
        <option value="recruiter">Recruiter</option>
      </select>
    </div>
    <button type="submit" class="btn btn-primary btn-block">Register</button>
  </form>
  <p class="text-center mt-1">Already have an account? <a href="/login">Log in here</a></p>
</div>
` }) %>
