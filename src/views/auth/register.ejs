<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-6">
      <%- include('../partials/flash') %>

      <!-- Registration Card -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-8 sm:p-10">
        <div class="text-center mb-8">
          <div class="inline-flex w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 items-center justify-center mb-3 shadow-xs">
            <i data-lucide="user-plus" class="w-6 h-6"></i>
          </div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-900">Create an Account</h1>
          <p class="text-xs text-slate-500 mt-1">Join the campus placement recruitment network</p>
        </div>

        <form action="/register" method="POST" class="space-y-5">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <!-- Role Selector -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Account Type</label>
            <div class="grid grid-cols-2 gap-3">
              <label class="relative flex flex-col p-3.5 border-2 rounded-xl cursor-pointer hover:border-brand-300 transition-all border-brand-500 bg-brand-50/30" id="role-card-student">
                <input type="radio" name="role" value="student" checked class="sr-only" onchange="updateRoleUi(this.value)">
                <div class="flex items-center gap-2 mb-1 text-slate-900 font-semibold text-sm">
                  <i data-lucide="graduation-cap" class="w-4 h-4 text-brand-600"></i>
                  <span>Student</span>
                </div>
                <span class="text-[11px] text-slate-500">Apply for jobs & tracks</span>
              </label>

              <label class="relative flex flex-col p-3.5 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-brand-300 transition-all" id="role-card-recruiter">
                <input type="radio" name="role" value="recruiter" class="sr-only" onchange="updateRoleUi(this.value)">
                <div class="flex items-center gap-2 mb-1 text-slate-900 font-semibold text-sm">
                  <i data-lucide="building-2" class="w-4 h-4 text-slate-600"></i>
                  <span>Recruiter</span>
                </div>
                <span class="text-[11px] text-slate-500">Post roles & hire talent</span>
              </label>
            </div>
          </div>

          <div>
            <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i data-lucide="mail" class="w-4 h-4"></i>
              </div>
              <input type="email" id="email" name="email" required
                class="w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
                placeholder="you@campus.edu">
            </div>
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i data-lucide="key-round" class="w-4 h-4"></i>
              </div>
              <input type="password" id="password" name="password" required minlength="6"
                class="w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
                placeholder="Minimum 6 characters">
            </div>
            <p class="text-[11px] text-slate-400 mt-1">Must contain at least 6 characters.</p>
          </div>

          <button type="submit"
            class="w-full mt-2 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm hover:shadow transition-all duration-150">
            <span>Create Account</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </form>

        <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
          Already registered? 
          <a href="/login" class="font-semibold text-brand-600 hover:text-brand-700 hover:underline">Sign in here</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
  <script>
    function updateRoleUi(selectedRole) {
      const studentCard = document.getElementById('role-card-student');
      const recruiterCard = document.getElementById('role-card-recruiter');
      if (selectedRole === 'student') {
        studentCard.classList.add('border-brand-500', 'bg-brand-50/30');
        studentCard.classList.remove('border-slate-200');
        recruiterCard.classList.remove('border-brand-500', 'bg-brand-50/30');
        recruiterCard.classList.add('border-slate-200');
      } else {
        recruiterCard.classList.add('border-brand-500', 'bg-brand-50/30');
        recruiterCard.classList.remove('border-slate-200');
        studentCard.classList.remove('border-brand-500', 'bg-brand-50/30');
        studentCard.classList.add('border-slate-200');
      }
    }
  </script>
</body>
</html>
