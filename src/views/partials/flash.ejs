<% if (typeof messages !== 'undefined') { %>
  <% if (messages.success && messages.success.length) { %>
    <div class="mb-6 space-y-2">
      <% messages.success.forEach(function(msg) { %>
        <div class="toast-alert flex items-start gap-3 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 shadow-sm transition-all duration-300">
          <div class="flex-shrink-0 text-emerald-600 mt-0.5">
            <i class="ph-bold ph-check-circle w-5 h-5"></i>
          </div>
          <div class="flex-1 text-sm font-medium leading-relaxed">
            <%= msg %>
          </div>
          <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-800 transition-colors p-1">
            <i class="ph-bold ph-x w-4 h-4"></i>
          </button>
        </div>
      <% }); %>
    </div>
  <% } %>

  <% if (messages.error && messages.error.length) { %>
    <div class="mb-6 space-y-2">
      <% messages.error.forEach(function(msg) { %>
        <div class="toast-alert flex items-start gap-3 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 shadow-sm transition-all duration-300">
          <div class="flex-shrink-0 text-rose-600 mt-0.5">
            <i class="ph-bold ph-warning-circle w-5 h-5"></i>
          </div>
          <div class="flex-1 text-sm font-medium leading-relaxed">
            <%= msg %>
          </div>
          <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-800 transition-colors p-1">
            <i class="ph-bold ph-x w-4 h-4"></i>
          </button>
        </div>
      <% }); %>
    </div>
  <% } %>

  <% if (messages.info && messages.info.length) { %>
    <div class="mb-6 space-y-2">
      <% messages.info.forEach(function(msg) { %>
        <div class="toast-alert flex items-start gap-3 p-4 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-900 shadow-sm transition-all duration-300">
          <div class="flex-shrink-0 text-indigo-600 mt-0.5">
            <i class="ph-bold ph-info w-5 h-5"></i>
          </div>
          <div class="flex-1 text-sm font-medium leading-relaxed">
            <%= msg %>
          </div>
          <button type="button" onclick="this.parentElement.remove()" class="text-indigo-500 hover:text-indigo-800 transition-colors p-1">
            <i class="ph-bold ph-x w-4 h-4"></i>
          </button>
        </div>
      <% }); %>
    </div>
  <% } %>
<% } %>
