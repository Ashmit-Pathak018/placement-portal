<% 
  const path = typeof currentPath !== 'undefined' ? currentPath : ''; 
  const user = typeof currentUser !== 'undefined' ? currentUser : null;

  // Compute initials
  let initials = 'U';
  if (user && user.email) {
    initials = user.email.substring(0, 2).toUpperCase();
  }
%>

<nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand & Desktop Navigation -->
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-brand-600 flex items-center justify-center text-white shadow-sm group-hover:bg-brand-700 transition-colors">
            <i class="ph-bold ph-graduation-cap w-5 h-5"></i>
          </div>
          <div>
            <span class="text-base font-bold tracking-tight text-slate-900 group-hover:text-brand-600 transition-colors">CampusPlace</span>
            <span class="hidden sm:inline-block ml-1.5 px-1.5 py-0.5 text-[10px] font-semibold tracking-wide uppercase bg-slate-100 text-slate-600 rounded">Portal</span>
          </div>
        </a>

        <% if (user) { %>
          <div class="hidden md:flex items-center gap-1">
            <% if (user.role === 'student') { %>
              <a href="/student/dashboard" class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 <%= path.includes('/dashboard') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>">
                <i class="ph-bold ph-squares-four w-4 h-4"></i>
                Dashboard
              </a>
              <a href="/student/postings" class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 <%= path.includes('/postings') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>">
                <i class="ph-bold ph-briefcase w-4 h-4"></i>
                Browse Jobs
              </a>
              <a href="/student/applications" class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 <%= path.includes('/applications') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>">
                <i class="ph-bold ph-file-check w-4 h-4"></i>
                My Applications
              </a>
              <a href="/student/profile" class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 <%= path.includes('/profile') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>">
                <i class="ph-bold ph-user w-4 h-4"></i>
                Profile
              </a>
            <% } else if (user.role === 'recruiter') { %>
              <a href="/recruiter/company" class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 <%= path.includes('/company') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>">
                <i class="ph-bold ph-buildings w-4 h-4"></i>
                Company Profile
              </a>
              <a href="/recruiter/postings" class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 <%= path.includes('/postings') || path.includes('/applicants') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>">
                <i class="ph-bold ph-briefcase w-4 h-4"></i>
                Job Postings
              </a>
            <% } else if (user.role === 'admin') { %>
              <a href="/admin/dashboard" class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 <%= path.includes('/dashboard') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>">
                <i class="ph-bold ph-squares-four w-4 h-4"></i>
                Dashboard
              </a>
              <a href="/admin/companies/pending" class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 <%= path.includes('/companies') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>">
                <i class="ph-bold ph-building w-4 h-4"></i>
                Companies
              </a>
              <a href="/admin/postings/pending" class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 <%= path.includes('/postings') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>">
                <i class="ph-bold ph-clipboard-text w-4 h-4"></i>
                Postings
              </a>
              <a href="/admin/audit-logs" class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 <%= path.includes('/audit-logs') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70' %>">
                <i class="ph-bold ph-shield-check w-4 h-4"></i>
                Audit Logs
              </a>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- Right Navigation Items -->
      <div class="flex items-center gap-3">
        <% if (user) { %>
          
          <!-- Notifications Popover Bell -->
          <div class="relative" id="notifications-wrapper">
            <button type="button" id="notification-bell-btn" class="relative p-2 rounded-lg text-slate-500 hover:text-slate-700 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500" aria-label="Notifications">
              <i class="ph-bold ph-bell w-5 h-5"></i>
              <span id="unread-count" class="hidden absolute top-1 right-1 px-1.5 py-0.5 text-[10px] font-bold leading-none text-white bg-rose-500 rounded-full border-2 border-white">0</span>
            </button>

            <!-- Dropdown Menu -->
            <div id="notifications-dropdown" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-white rounded-xl shadow-elevated border border-slate-200 py-2 z-50 divide-y divide-slate-100">
              <div class="px-4 py-2.5 flex items-center justify-between">
                <span class="text-sm font-bold text-slate-900 flex items-center gap-1.5">
                  <i class="ph-bold ph-bell-ringing w-4 h-4 text-brand-600"></i>
                  Notifications
                </span>
                <% if (user.role === 'student') { %>
                  <form action="/student/notifications/read-all" method="POST" class="inline m-0">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <button type="submit" class="text-xs font-medium text-brand-600 hover:text-brand-700 hover:underline">
                      Mark all read
                    </button>
                  </form>
                <% } %>
              </div>
              <div id="notifications-list" class="max-h-72 overflow-y-auto divide-y divide-slate-50">
                <div class="p-4 text-center text-xs text-slate-400">Loading notifications...</div>
              </div>
            </div>
          </div>

          <!-- User Info & Avatar -->
          <div class="hidden sm:flex items-center gap-3 pl-3 border-l border-slate-200">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-bold tracking-tight">
                <%= initials %>
              </div>
              <div class="flex flex-col">
                <span class="text-xs font-semibold text-slate-900 truncate max-w-[140px]"><%= user.email %></span>
                <span class="text-[10px] font-medium text-slate-500 uppercase tracking-wide flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full <%= user.role === 'admin' ? 'bg-purple-500' : (user.role === 'recruiter' ? 'bg-blue-500' : 'bg-emerald-500') %>"></span>
                  <%= user.role %>
                </span>
              </div>
            </div>

            <!-- Logout Button -->
            <form action="/logout" method="POST" class="inline m-0">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-colors" title="Log out">
                <i class="ph-bold ph-sign-out w-4 h-4"></i>
              </button>
            </form>
          </div>

          <!-- Mobile Hamburger Toggle -->
          <div class="flex md:hidden">
            <button type="button" id="mobile-menu-btn" class="p-2 rounded-lg text-slate-600 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500" aria-label="Toggle Navigation">
              <i class="ph-bold ph-list w-5 h-5"></i>
            </button>
          </div>

        <% } else { %>
          <a href="/login" class="text-sm font-medium text-slate-600 hover:text-slate-900 px-3 py-1.5 rounded-lg hover:bg-slate-100 transition-colors">
            Log in
          </a>
          <a href="/register" class="text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 px-4 py-2 rounded-lg shadow-sm transition-colors">
            Get Started
          </a>
        <% } %>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <% if (user) { %>
    <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 px-4 pt-2 pb-4 space-y-1 bg-white">
      <% if (user.role === 'student') { %>
        <a href="/student/dashboard" class="block px-3 py-2 rounded-lg text-sm font-medium <%= path.includes('/dashboard') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-700 hover:bg-slate-50' %>">Dashboard</a>
        <a href="/student/postings" class="block px-3 py-2 rounded-lg text-sm font-medium <%= path.includes('/postings') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-700 hover:bg-slate-50' %>">Browse Jobs</a>
        <a href="/student/applications" class="block px-3 py-2 rounded-lg text-sm font-medium <%= path.includes('/applications') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-700 hover:bg-slate-50' %>">My Applications</a>
        <a href="/student/profile" class="block px-3 py-2 rounded-lg text-sm font-medium <%= path.includes('/profile') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-700 hover:bg-slate-50' %>">Profile</a>
      <% } else if (user.role === 'recruiter') { %>
        <a href="/recruiter/company" class="block px-3 py-2 rounded-lg text-sm font-medium <%= path.includes('/company') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-700 hover:bg-slate-50' %>">Company Profile</a>
        <a href="/recruiter/postings" class="block px-3 py-2 rounded-lg text-sm font-medium <%= path.includes('/postings') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-700 hover:bg-slate-50' %>">Job Postings</a>
      <% } else if (user.role === 'admin') { %>
        <a href="/admin/dashboard" class="block px-3 py-2 rounded-lg text-sm font-medium <%= path.includes('/dashboard') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-700 hover:bg-slate-50' %>">Dashboard</a>
        <a href="/admin/companies/pending" class="block px-3 py-2 rounded-lg text-sm font-medium <%= path.includes('/companies') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-700 hover:bg-slate-50' %>">Companies</a>
        <a href="/admin/postings/pending" class="block px-3 py-2 rounded-lg text-sm font-medium <%= path.includes('/postings') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-700 hover:bg-slate-50' %>">Postings</a>
        <a href="/admin/audit-logs" class="block px-3 py-2 rounded-lg text-sm font-medium <%= path.includes('/audit-logs') ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-700 hover:bg-slate-50' %>">Audit Logs</a>
      <% } %>

      <div class="pt-3 border-t border-slate-200 mt-2 flex items-center justify-between">
        <span class="text-xs text-slate-500"><%= user.email %> (<%= user.role %>)</span>
        <form action="/logout" method="POST" class="inline m-0">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="text-xs font-semibold text-rose-600 hover:underline">Log out</button>
        </form>
      </div>
    </div>
  <% } %>
</nav>
