<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col page-bg text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <div>
      <a href="/recruiter/postings/<%= application.posting_id %>/applicants" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
        <i class="ph-bold ph-arrow-left w-3.5 h-3.5"></i>
        Back to Candidate Pipeline
      </a>
    </div>

    <!-- Candidate Dossier Header Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-brand-50 border border-brand-200 text-brand-700 flex items-center justify-center text-xl font-bold">
            <%= (application.name || 'Candidate').substring(0, 2).toUpperCase() %>
          </div>
          <div class="space-y-1">
            <h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= application.name %></h1>
            <div class="text-xs text-slate-500 flex items-center gap-2 flex-wrap">
              <span><%= application.email %></span>
              <span>&bull;</span>
              <span>Applied for <strong class="text-slate-800"><%= application.posting_title %></strong></span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <span class="badge badge-<%= application.status %> text-sm py-1.5 px-3.5">
            <span class="badge-dot"></span>
            <%= application.status.replace('_', ' ') %>
          </span>
        </div>
      </div>

      <!-- Academic & Application Metrics -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 mt-6 border-t border-slate-100 text-xs">
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 space-y-0.5">
          <span class="text-slate-500 block">Department</span>
          <span class="font-bold text-slate-900 text-sm"><%= application.branch || 'N/A' %></span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 space-y-0.5">
          <span class="text-slate-500 block">Academic CGPA</span>
          <span class="font-bold text-emerald-600 text-sm"><%= application.cgpa ? application.cgpa.toFixed(2) : '0.00' %></span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 space-y-0.5">
          <span class="text-slate-500 block">Graduation Batch</span>
          <span class="font-bold text-slate-900 text-sm"><%= application.grad_year || 'N/A' %></span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 space-y-0.5 flex flex-col justify-center">
          <span class="text-slate-500 block">Resume / Portfolio</span>
          <% if (application.resume_url) { %>
            <a href="<%= application.resume_url %>" target="_blank" rel="noopener noreferrer"
               class="font-bold text-brand-600 hover:text-brand-700 hover:underline flex items-center gap-1">
              <span>View Resume</span>
              <i class="ph-bold ph-arrow-square-out w-3 h-3"></i>
            </a>
          <% } else { %>
            <span class="text-slate-400">Not provided</span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Status Transition Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-4">
      <div class="border-b border-slate-100 pb-3">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <i class="ph-bold ph-git-pull-request w-4 h-4 text-brand-600"></i>
          Update Pipeline Status
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">Only allowed state transitions are permitted by recruitment workflow rules.</p>
      </div>

      <% if (allowedTransitions && allowedTransitions.length > 0) { %>
        <form action="/recruiter/applications/<%= application.id %>/status" method="POST" class="space-y-4 pt-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="status" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                New Target Stage <span class="text-rose-500">*</span>
              </label>
              <select id="status" name="status" required
                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all font-medium">
                <option value="">Select next pipeline stage...</option>
                <% allowedTransitions.forEach(st => { %>
                  <option value="<%= st %>"><%= st.replace('_', ' ').toUpperCase() %></option>
                <% }); %>
              </select>
            </div>

            <div>
              <label for="note" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                Feedback / Interview Note (Optional)
              </label>
              <input type="text" id="note" name="note"
                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
                placeholder="e.g. Cleared technical screen; scheduled for HR round.">
            </div>
          </div>

          <div class="flex justify-end pt-2">
            <button type="submit"
              class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-xs transition-colors flex items-center gap-1.5">
              <i class="ph-bold ph-check w-4 h-4"></i>
              Confirm Transition
            </button>
          </div>
        </form>
      <% } else { %>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 flex items-center gap-2">
          <i class="ph-bold ph-lock w-4 h-4 text-slate-400"></i>
          <span>This application is in a terminal stage (<strong><%= application.status %></strong>). No further status transitions are allowed.</span>
        </div>
      <% } %>
    </div>

    <!-- Candidate History Timeline -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-6">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <i class="ph-bold ph-clock-counter-clockwise w-4 h-4 text-brand-600"></i>
          Application History Log
        </h2>
        <span class="text-xs text-slate-500"><%= history ? history.length : 0 %> events</span>
      </div>

      <% if (history && history.length > 0) { %>
        <div class="timeline-track pt-2">
          <% history.forEach(entry => { %>
            <div class="timeline-node">
              <div class="timeline-marker">
                <span class="w-2 h-2 rounded-full <%= entry.to_status === 'offered' ? 'bg-emerald-600' : (entry.to_status === 'rejected' ? 'bg-rose-600' : 'bg-brand-600') %>"></span>
              </div>
              <div class="space-y-1.5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-bold text-slate-900 text-sm">
                      <%= entry.from_status ? (entry.from_status.replace('_', ' ') + ' ? ' + entry.to_status.replace('_', ' ')) : 'Applied' %>
                    </span>
                    <span class="badge badge-<%= entry.to_status %>">
                      <%= entry.to_status.replace('_', ' ') %>
                    </span>
                  </div>
                  <span class="text-[11px] text-slate-400">
                    <%= new Date(entry.changed_at).toLocaleString() %>
                  </span>
                </div>
                <% if (entry.note) { %>
                  <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-slate-700">
                    <%= entry.note %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="py-6 text-center text-xs text-slate-400">No history entries found.</div>
      <% } %>
    </div>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
