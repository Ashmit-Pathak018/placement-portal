<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <!-- Back to Postings Navigation -->
    <div>
      <a href="/recruiter/postings" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
        Back to All Postings
      </a>
    </div>

    <!-- Header Card with View Switcher -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="badge <%= posting.type === 'job' ? 'badge-job' : 'badge-internship' %>">
              <%= posting.type %>
            </span>
            <span class="text-xs text-slate-500">Min CGPA: <strong><%= posting.min_cgpa %></strong></span>
            <span class="text-xs text-slate-400">&bull;</span>
            <span class="text-xs text-slate-500">Deadline: <%= new Date(posting.deadline).toLocaleDateString() %></span>
          </div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-900">
            Candidate Pipeline: <%= posting.title %>
          </h1>
          <p class="text-xs text-slate-500">Review, shortlist, interview, and offer candidates using table filters or visual drag-and-drop Kanban.</p>
        </div>

        <!-- View Mode Segmented Controls -->
        <div class="flex items-center bg-slate-100 p-1 rounded-xl self-start md:self-auto border border-slate-200/80">
          <button type="button" onclick="switchView('table')" id="btn-view-table"
            class="px-4 py-2 text-xs font-bold rounded-lg transition-all flex items-center gap-1.5 bg-white text-slate-900 shadow-xs">
            <i data-lucide="table" class="w-3.5 h-3.5"></i>
            Table View
          </button>
          <button type="button" onclick="switchView('kanban')" id="btn-view-kanban"
            class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition-all flex items-center gap-1.5">
            <i data-lucide="kanban" class="w-3.5 h-3.5"></i>
            Kanban Board
          </button>
        </div>
      </div>
    </div>

    <!-- Contextual Batch Action Toolbar -->
    <div id="batch-actions-bar" class="hidden bg-slate-900 text-white rounded-2xl p-4 shadow-elevated transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center text-brand-300">
          <i data-lucide="check-square" class="w-4 h-4"></i>
        </div>
        <div class="text-xs">
          Selected: <strong id="batch-selected-count" class="text-white text-sm font-bold ml-1">0</strong> candidates
        </div>
      </div>

      <form action="/recruiter/applications/batch-status" method="POST" id="batch-form" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="postingId" value="<%= posting.id %>">
        
        <select name="newStatus" required
          class="px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">Move selected to stage...</option>
          <% statuses.forEach(s => { %>
            <option value="<%= s %>"><%= s.replace('_', ' ').toUpperCase() %></option>
          <% }); %>
        </select>

        <input type="text" name="note" placeholder="Feedback/note (optional)"
          class="px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500">

        <button type="submit"
          class="px-4 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded-xl transition-colors shadow-xs whitespace-nowrap">
          Apply Batch Update
        </button>
      </form>
    </div>

    <!-- Dynamic Alert Container for Drag-and-Drop Responses -->
    <div id="kanban-toast" class="hidden"></div>

    <!-- TABLE VIEW -->
    <div id="table-view" class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden">
      <% if (applicants && applicants.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200/80 text-[11px] font-semibold text-slate-500 uppercase tracking-wider">
                <th class="py-3.5 px-4 w-10">
                  <input type="checkbox" id="selectAll" class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300">
                </th>
                <th class="py-3.5 px-4">Candidate Profile</th>
                <th class="py-3.5 px-4">Department</th>
                <th class="py-3.5 px-4">CGPA</th>
                <th class="py-3.5 px-4">Applied Date</th>
                <th class="py-3.5 px-4">Current Stage</th>
                <th class="py-3.5 px-6 text-right">Quick Transition & Profile</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs">
              <% applicants.forEach(app => { 
                const initials = (app.name || 'Student').substring(0, 2).toUpperCase();
              %>
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="py-3.5 px-4">
                    <input type="checkbox" name="applicationIds" value="<%= app.application_id %>" form="batch-form"
                      class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300">
                  </td>
                  <td class="py-3.5 px-4">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-xs text-slate-700 shrink-0">
                        <%= initials %>
                      </div>
                      <div>
                        <div class="font-bold text-slate-900 text-sm">
                          <a href="/recruiter/applicants/<%= app.application_id %>" class="hover:text-brand-600 transition-colors"><%= app.name %></a>
                        </div>
                        <div class="text-[11px] text-slate-400"><%= app.email %></div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <span class="px-2 py-0.5 rounded font-semibold text-xs bg-slate-100 text-slate-700">
                      <%= app.branch || 'N/A' %>
                    </span>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <strong class="text-sm <%= app.cgpa >= 8.0 ? 'text-emerald-600' : 'text-slate-800' %>">
                      <%= app.cgpa ? app.cgpa.toFixed(2) : '0.00' %>
                    </strong>
                  </td>
                  <td class="py-3.5 px-4 text-slate-500 whitespace-nowrap">
                    <%= new Date(app.applied_at).toLocaleDateString() %>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <span class="badge badge-<%= app.status %>">
                      <span class="badge-dot"></span>
                      <%= app.status.replace('_', ' ') %>
                    </span>
                  </td>
                  <td class="py-3.5 px-6 text-right whitespace-nowrap space-x-2">
                    <!-- Inline status dropdown -->
                    <form action="/recruiter/applications/<%= app.application_id %>/status" method="POST" class="inline-block m-0">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <select name="status" onchange="this.form.submit()"
                        class="px-2.5 py-1 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-700 focus:bg-white focus:ring-1 focus:ring-brand-500">
                        <% statuses.forEach(s => { %>
                          <option value="<%= s %>" <%= app.status === s ? 'selected' : '' %>><%= s.replace('_', ' ') %></option>
                        <% }); %>
                      </select>
                    </form>

                    <a href="/recruiter/applicants/<%= app.application_id %>"
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-xs transition-colors">
                      Profile &rarr;
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="p-12 text-center space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
            <i data-lucide="users" class="w-6 h-6"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900">No Candidates Applied Yet</h3>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">When eligible students submit applications for this role, they will appear here in your tracking pipeline.</p>
        </div>
      <% } %>
    </div>

    <!-- KANBAN VIEW -->
    <div id="kanban-view" class="hidden">
      <div class="kanban-board">
        <% statuses.forEach(status => { 
          const colApps = applicants.filter(a => a.status === status);
        %>
          <div class="kanban-column">
            
            <!-- Column Header -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200/80">
              <span class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
                <span class="badge-dot <%= status === 'offered' ? 'bg-emerald-500' : (status === 'rejected' ? 'bg-rose-500' : (status === 'interview' ? 'bg-purple-500' : 'bg-brand-500')) %>"></span>
                <%= status.replace('_', ' ') %>
              </span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-white text-slate-700 border border-slate-200 shadow-2xs">
                <%= colApps.length %>
              </span>
            </div>

            <!-- Draggable List -->
            <div class="kanban-list flex-1 space-y-2 min-h-[300px]" data-status="<%= status %>">
              <% colApps.forEach(app => { 
                const initials = (app.name || 'Candidate').substring(0, 2).toUpperCase();
              %>
                <div class="kanban-card group" data-id="<%= app.application_id %>">
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <div class="flex items-center gap-2">
                      <div class="w-7 h-7 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-[10px] text-slate-700">
                        <%= initials %>
                      </div>
                      <div>
                        <a href="/recruiter/applicants/<%= app.application_id %>" class="font-bold text-xs text-slate-900 hover:text-brand-600 transition-colors block">
                          <%= app.name %>
                        </a>
                        <span class="text-[10px] text-slate-400 block"><%= app.email %></span>
                      </div>
                    </div>
                  </div>

                  <div class="flex items-center justify-between text-[11px] pt-2 border-t border-slate-100 text-slate-500">
                    <div class="flex items-center gap-1.5">
                      <span class="font-semibold px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px]">
                        <%= app.branch || 'CSE' %>
                      </span>
                      <span>CGPA: <strong><%= app.cgpa ? app.cgpa.toFixed(1) : '-' %></strong></span>
                    </div>
                    <span class="text-[10px] text-slate-400">
                      <%= new Date(app.applied_at).toLocaleDateString() %>
                    </span>
                  </div>
                </div>
              <% }); %>
            </div>

          </div>
        <% }); %>
      </div>
    </div>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
  <script>
    // Toggle View State
    function switchView(view) {
      const tableView = document.getElementById('table-view');
      const kanbanView = document.getElementById('kanban-view');
      const btnTable = document.getElementById('btn-view-table');
      const btnKanban = document.getElementById('btn-view-kanban');

      if (view === 'table') {
        tableView.classList.remove('hidden');
        kanbanView.classList.add('hidden');
        btnTable.className = "px-4 py-2 text-xs font-bold rounded-lg transition-all flex items-center gap-1.5 bg-white text-slate-900 shadow-xs";
        btnKanban.className = "px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition-all flex items-center gap-1.5";
      } else {
        tableView.classList.add('hidden');
        kanbanView.classList.remove('hidden');
        btnKanban.className = "px-4 py-2 text-xs font-bold rounded-lg transition-all flex items-center gap-1.5 bg-white text-slate-900 shadow-xs";
        btnTable.className = "px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition-all flex items-center gap-1.5";
      }
    }

    // SortableJS Drag & Drop Initialization
    const toastBox = document.getElementById('kanban-toast');
    const lists = document.querySelectorAll('.kanban-list');
    
    lists.forEach(list => {
      new Sortable(list, {
        group: 'shared-pipeline',
        animation: 180,
        ghostClass: 'sortable-ghost',
        onEnd: function (evt) {
          const itemEl = evt.item;
          const newStatus = evt.to.getAttribute('data-status');
          const oldStatus = evt.from.getAttribute('data-status');
          const appId = itemEl.getAttribute('data-id');

          if (newStatus === oldStatus) return;

          fetch(`/recruiter/applications/${appId}/status`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'Accept': 'application/json'
            },
            body: new URLSearchParams({
              _csrf: '<%= csrfToken %>',
              status: newStatus
            })
          })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              showKanbanNotice(`Candidate moved to ${newStatus.replace('_', ' ').toUpperCase()}`, 'success');
            } else {
              // Revert position if transition is illegal
              evt.from.appendChild(itemEl);
              showKanbanNotice(`Illegal status transition: ${data.error || 'Not allowed by recruitment rules.'}`, 'error');
            }
          })
          .catch(err => {
            evt.from.appendChild(itemEl);
            showKanbanNotice('Network error updating candidate status.', 'error');
          });
        }
      });
    });

    function showKanbanNotice(msg, type) {
      if (!toastBox) return;
      toastBox.className = `p-3 rounded-xl text-xs font-medium flex items-center gap-2 shadow-sm ${type === 'success' ? 'bg-emerald-50 border border-emerald-200 text-emerald-900' : 'bg-rose-50 border border-rose-200 text-rose-900'}`;
      toastBox.innerHTML = `
        <i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}" class="w-4 h-4 ${type === 'success' ? 'text-emerald-600' : 'text-rose-600'}"></i>
        <span>${msg}</span>
      `;
      toastBox.classList.remove('hidden');
      if (window.lucide) window.lucide.createIcons();
      setTimeout(() => toastBox.classList.add('hidden'), 4000);
    }
  </script>
</body>
</html>
