<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-2xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <div>
      <a href="/recruiter/company" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
        Back to Company Profile
      </a>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-6">
      <div>
        <h1 class="text-xl font-bold tracking-tight text-slate-900">Edit Company Information</h1>
        <p class="text-xs text-slate-500 mt-1">Update your organization's public campus recruitment details.</p>
      </div>

      <form action="/recruiter/company/edit" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div>
          <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
            Company Name <span class="text-rose-500">*</span>
          </label>
          <input type="text" id="name" name="name" value="<%= company.name %>" required
            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
        </div>

        <div>
          <label for="website" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
            Official Website URL
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i data-lucide="globe" class="w-4 h-4"></i>
            </div>
            <input type="url" id="website" name="website" value="<%= company.website || '' %>"
              class="w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
          </div>
        </div>

        <div>
          <label for="description" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
            Company Overview
          </label>
          <textarea id="description" name="description" rows="5"
            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"><%= company.description || '' %></textarea>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
          <a href="/recruiter/company" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            Cancel
          </a>
          <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition-colors flex items-center gap-1.5">
            <i data-lucide="save" class="w-4 h-4"></i>
            Save Changes
          </button>
        </div>
      </form>
    </div>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
