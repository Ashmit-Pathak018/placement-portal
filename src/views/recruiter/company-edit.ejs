<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — CampusPlace</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container">
    <%- include('../partials/flash') %>
    
    <h1>Edit Company Profile</h1>
    <form action="/recruiter/company/edit" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label>Company Name</label>
        <input type="text" name="name" value="<%= company.name %>" required>
      </div>
      <div>
        <label>Website</label>
        <input type="url" name="website" value="<%= company.website %>">
      </div>
      <div>
        <label>Description</label>
        <textarea name="description" rows="4"><%= company.description %></textarea>
      </div>
      <button type="submit">Update Company</button>
      <a href="/recruiter/company" class="btn-cancel">Cancel</a>
    </form>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
