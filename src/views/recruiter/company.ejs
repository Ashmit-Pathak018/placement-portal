<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col page-bg text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <% if (!company) { %>
      <!-- Company Creation State -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-10 space-y-6">
        <div class="text-center max-w-md mx-auto space-y-2">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center mx-auto shadow-xs">
            <i class="ph-bold ph-buildings w-6 h-6"></i>
          </div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-900">Register Your Organization</h1>
          <p class="text-xs text-slate-500">Create your company profile to start posting campus recruitment drives and internship openings.</p>
        </div>

        <form action="/recruiter/company" method="POST" class="space-y-5 max-w-lg mx-auto pt-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div>
            <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Company Name <span class="text-rose-500">*</span>
            </label>
            <input type="text" id="name" name="name" required
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
              placeholder="e.g. Acme Technologies">
          </div>

          <div>
            <label for="website" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Official Website URL
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i class="ph-bold ph-globe w-4 h-4"></i>
              </div>
              <input type="url" id="website" name="website"
                class="w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
                placeholder="https://acme.tech">
            </div>
          </div>

          <div>
            <label for="description" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Company Overview & Culture
            </label>
            <textarea id="description" name="description" rows="4"
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
              placeholder="Describe your organization, mission, and products..."></textarea>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 flex items-start gap-2.5">
            <i class="ph-bold ph-info w-4 h-4 text-brand-600 shrink-0 mt-0.5"></i>
            <span>All new company registrations require verification by the institutional Placement Cell Admin before job postings can go live.</span>
          </div>

          <button type="submit"
            class="w-full py-2.5 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition-all flex items-center justify-center gap-2">
            <i class="ph-bold ph-check w-4 h-4"></i>
            Submit for Approval
          </button>
        </form>
      </div>

    <% } else { %>
      
      <!-- Existing Company Profile -->
      <div class="space-y-6">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Organization Profile</h1>
            <p class="text-xs text-slate-500 mt-1">Manage institutional credentials, verification status, and hiring presence.</p>
          </div>
          <div class="flex items-center gap-3">
            <a href="/recruiter/company/edit" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 shadow-xs transition-colors">
              <i class="ph-bold ph-pencil-simple w-3.5 h-3.5"></i>
              Edit Profile
            </a>
            <% if (company.status === 'approved') { %>
              <a href="/recruiter/postings/new" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-xl bg-brand-600 hover:bg-brand-700 text-white shadow-xs transition-colors">
                <i class="ph-bold ph-plus w-3.5 h-3.5"></i>
                Create Posting
              </a>
            <% } %>
          </div>
        </div>

        <!-- Verification Status Notice -->
        <% if (company.status === 'pending') { %>
          <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-start gap-3">
            <i class="ph-bold ph-clock w-4 h-4 text-amber-600 shrink-0 mt-0.5"></i>
            <div class="space-y-1">
              <span class="font-bold">Pending Placement Cell Verification</span>
              <p class="text-amber-800 text-[11px]">Your company profile is under administrative review. Once approved by the Placement Cell Admin, you will be able to create live job postings and receive student applicants.</p>
            </div>
          </div>
        <% } else if (company.status === 'approved') { %>
          <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs flex items-start gap-3">
            <i class="ph-bold ph-check-circle w-4 h-4 text-emerald-600 shrink-0 mt-0.5"></i>
            <div class="space-y-1">
              <span class="font-bold">Verified Institutional Recruiter</span>
              <p class="text-emerald-800 text-[11px]">Your organization is verified and approved. You can actively publish recruitment postings and review student applicants.</p>
            </div>
          </div>
        <% } else if (company.status === 'rejected') { %>
          <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 text-xs flex items-start gap-3">
            <i class="ph-bold ph-x-circle w-4 h-4 text-rose-600 shrink-0 mt-0.5"></i>
            <div class="space-y-1">
              <span class="font-bold">Organization Registration Not Approved</span>
              <p class="text-rose-800 text-[11px]">Please contact the Placement Cell or edit your company information to re-apply for verification.</p>
            </div>
          </div>
        <% } %>

        <!-- Company Card Details -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-6">
          <div class="flex items-start justify-between gap-4 pb-6 border-b border-slate-100">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-brand-50 border border-brand-200 text-brand-700 flex items-center justify-center text-xl font-bold">
                <%= company.name.substring(0, 2).toUpperCase() %>
              </div>
              <div>
                <h2 class="text-xl font-bold text-slate-900"><%= company.name %></h2>
                <% if (company.website) { %>
                  <a href="<%= company.website %>" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-brand-600 hover:text-brand-700 hover:underline flex items-center gap-1 mt-0.5">
                    <%= company.website %>
                    <i class="ph-bold ph-arrow-square-out w-3 h-3"></i>
                  </a>
                <% } %>
              </div>
            </div>

            <span class="badge badge-<%= company.status %> text-xs py-1 px-3">
              <span class="badge-dot"></span>
              <%= company.status %>
            </span>
          </div>

          <div class="space-y-2">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">About the Organization</h3>
            <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-line">
              <%= company.description || 'No company description provided.' %>
            </p>
          </div>

          <div class="pt-6 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Created: <%= new Date(company.created_at).toLocaleDateString() %></span>
            <a href="/recruiter/postings" class="font-semibold text-brand-600 hover:text-brand-700 hover:underline flex items-center gap-1">
              View Active Postings <i class="ph-bold ph-arrow-right w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>

      </div>

    <% } %>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
