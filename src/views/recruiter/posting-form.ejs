<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — CampusPlace</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container">
    <%- include('../partials/flash') %>
    
    <h1><%= title %></h1>
    <form action="<%= posting ? `/recruiter/postings/${posting.id}/edit` : '/recruiter/postings/new' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div>
        <label>Title</label>
        <input type="text" name="title" value="<%= posting ? posting.title : '' %>" required>
      </div>
      <div>
        <label>Description</label>
        <textarea name="description" rows="5" required><%= posting ? posting.description : '' %></textarea>
      </div>
      <div>
        <label>Type</label>
        <select name="type" required>
          <option value="job" <%= posting && posting.type === 'job' ? 'selected' : '' %>>Job</option>
          <option value="internship" <%= posting && posting.type === 'internship' ? 'selected' : '' %>>Internship</option>
        </select>
      </div>
      <div>
        <label>Minimum CGPA</label>
        <input type="number" step="0.01" name="min_cgpa" value="<%= posting ? posting.min_cgpa : '' %>">
      </div>
      <div>
        <label>Graduation Year</label>
        <input type="number" name="grad_year" value="<%= posting ? posting.grad_year : '' %>">
      </div>
      <div>
        <label>Deadline</label>
        <% 
          let deadlineStr = '';
          if (posting && posting.deadline) {
            deadlineStr = new Date(posting.deadline).toISOString().split('T')[0];
          }
        %>
        <input type="date" name="deadline" value="<%= deadlineStr %>">
      </div>
      
      <div>
        <label>Eligible Branches</label>
        <div class="checkbox-grid">
          <% const branchOptions = ['CSE', 'ECE', 'EEE', 'ME', 'CE', 'IT', 'CHE', 'BT']; %>
          <% branchOptions.forEach(b => { %>
            <label>
              <input type="checkbox" name="branches" value="<%= b %>" <%= branches && branches.includes(b) ? 'checked' : '' %>>
              <%= b %>
            </label>
          <% }) %>
        </div>
      </div>
      
      <button type="submit"><%= posting ? 'Update Posting' : 'Create Posting' %></button>
      <a href="/recruiter/postings" class="btn-cancel">Cancel</a>
    </form>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
