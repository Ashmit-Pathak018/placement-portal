<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col page-bg text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-3xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <div>
      <a href="/recruiter/postings" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
        <i class="ph-bold ph-arrow-left w-3.5 h-3.5"></i>
        Back to Postings
      </a>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-6">
      <div class="border-b border-slate-100 pb-4">
        <h1 class="text-xl font-bold tracking-tight text-slate-900">
          <%= posting ? 'Edit Recruitment Posting' : 'Create New Recruitment Posting' %>
        </h1>
        <p class="text-xs text-slate-500 mt-1">Specify job specifications, cutoff criteria, and allowed academic departments.</p>
      </div>

      <form action="<%= posting ? `/recruiter/postings/${posting.id}/edit` : '/recruiter/postings/new' %>" method="POST" class="space-y-6">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="space-y-5">
          
          <!-- Title & Type -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
              <label for="title" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                Job / Internship Title <span class="text-rose-500">*</span>
              </label>
              <input type="text" id="title" name="title" value="<%= posting ? posting.title : '' %>" required
                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
                placeholder="e.g. Software Engineer, Data Science Intern">
            </div>

            <div>
              <label for="type" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                Role Type <span class="text-rose-500">*</span>
              </label>
              <select id="type" name="type" required
                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
                <option value="job" <%= posting && posting.type === 'job' ? 'selected' : '' %>>Full-Time Job</option>
                <option value="internship" <%= posting && posting.type === 'internship' ? 'selected' : '' %>>Internship</option>
              </select>
            </div>
          </div>

          <!-- Description -->
          <div>
            <label for="description" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Role Description & Candidate Expectations <span class="text-rose-500">*</span>
            </label>
            <textarea id="description" name="description" rows="5" required
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
              placeholder="Outline responsibilities, compensation, work location, and required technical skills..."><%= posting ? posting.description : '' %></textarea>
          </div>

          <!-- Requirements: Min CGPA, Grad Year, Deadline -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="min_cgpa" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                Minimum CGPA Cutoff <span class="text-rose-500">*</span>
              </label>
              <input type="number" id="min_cgpa" name="min_cgpa" step="0.01" min="0" max="10" required
                value="<%= posting ? posting.min_cgpa : '7.0' %>"
                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
            </div>

            <div>
              <label for="grad_year" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                Batch Year (Optional)
              </label>
              <input type="number" id="grad_year" name="grad_year" min="2000" max="2100"
                value="<%= posting && posting.grad_year ? posting.grad_year : '' %>"
                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
                placeholder="Leave blank for any">
            </div>

            <div>
              <label for="deadline" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                Application Deadline <span class="text-rose-500">*</span>
              </label>
              <% 
                let deadlineStr = '';
                if (posting && posting.deadline) {
                  deadlineStr = new Date(posting.deadline).toISOString().split('T')[0];
                }
              %>
              <input type="date" id="deadline" name="deadline" value="<%= deadlineStr %>" required
                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
            </div>
          </div>

          <!-- Eligible Branches (Modern Pill Selectors) -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider">
                Eligible Academic Departments
              </label>
              <span class="text-[11px] text-slate-400">Select all allowed branches</span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <% const allBranches = ['CSE', 'ECE', 'EEE', 'ME', 'CE', 'IT', 'CHE', 'BT']; %>
              <% allBranches.forEach(b => { 
                const isChecked = branches && branches.includes(b);
              %>
                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-100/70 cursor-pointer transition-colors text-xs font-medium text-slate-800">
                  <input type="checkbox" name="branches" value="<%= b %>" <%= isChecked ? 'checked' : '' %>
                    class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300">
                  <span><%= b %></span>
                </label>
              <% }); %>
            </div>
          </div>

        </div>

        <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
          <a href="/recruiter/postings" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            Cancel
          </a>
          <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition-colors flex items-center gap-2">
            <i class="ph-bold ph-check w-4 h-4"></i>
            <%= posting ? 'Save Changes' : 'Submit for Approval' %>
          </button>
        </div>

      </form>
    </div>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
