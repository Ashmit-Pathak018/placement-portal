<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <!-- Header & Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Job & Internship Postings</h1>
        <p class="text-xs text-slate-500 mt-1">Manage recruitment drives, review criteria, and monitor student pipelines.</p>
      </div>

      <% if (company && company.status === 'approved') { %>
        <a href="/recruiter/postings/new" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-xl bg-brand-600 hover:bg-brand-700 text-white shadow-xs transition-colors self-start sm:self-auto">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          Create New Posting
        </a>
      <% } else if (company) { %>
        <div class="p-2.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs flex items-center gap-2">
          <i data-lucide="clock" class="w-4 h-4 text-amber-600"></i>
          <span>Posting creation locked until company approval.</span>
        </div>
      <% } %>
    </div>

    <!-- Postings Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden">
      <% if (postings && postings.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200/80 text-[11px] font-semibold text-slate-500 uppercase tracking-wider">
                <th class="py-3.5 px-6">Role Title</th>
                <th class="py-3.5 px-4">Type</th>
                <th class="py-3.5 px-4">Min CGPA</th>
                <th class="py-3.5 px-4">Deadline</th>
                <th class="py-3.5 px-4">Approval Status</th>
                <th class="py-3.5 px-4">Applicants</th>
                <th class="py-3.5 px-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs">
              <% postings.forEach(posting => { %>
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="py-4 px-6 font-bold text-slate-900 text-sm">
                    <%= posting.title %>
                  </td>
                  <td class="py-4 px-4 whitespace-nowrap">
                    <span class="badge <%= posting.type === 'job' ? 'badge-job' : 'badge-internship' %>">
                      <%= posting.type %>
                    </span>
                  </td>
                  <td class="py-4 px-4 text-slate-700 font-semibold whitespace-nowrap">
                    <%= posting.min_cgpa %>
                  </td>
                  <td class="py-4 px-4 text-slate-500 whitespace-nowrap">
                    <%= posting.deadline ? new Date(posting.deadline).toLocaleDateString() : 'No deadline' %>
                  </td>
                  <td class="py-4 px-4 whitespace-nowrap">
                    <span class="badge badge-<%= posting.status %>">
                      <span class="badge-dot"></span>
                      <%= posting.status %>
                    </span>
                  </td>
                  <td class="py-4 px-4 whitespace-nowrap">
                    <a href="/recruiter/postings/<%= posting.id %>/applicants"
                       class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold <%= posting.applicant_count > 0 ? 'bg-indigo-50 text-indigo-700 hover:bg-indigo-100' : 'bg-slate-100 text-slate-600' %> transition-colors">
                      <i data-lucide="users" class="w-3.5 h-3.5"></i>
                      <%= posting.applicant_count %> candidates
                    </a>
                  </td>
                  <td class="py-4 px-6 text-right whitespace-nowrap space-x-2">
                    <a href="/recruiter/postings/<%= posting.id %>/applicants"
                       class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs shadow-xs transition-colors">
                      <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
                      <span>Pipeline</span>
                    </a>
                    <a href="/recruiter/postings/<%= posting.id %>/edit"
                       class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-xs transition-colors">
                      <i data-lucide="edit" class="w-3 h-3"></i>
                      <span>Edit</span>
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="p-12 text-center space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
            <i data-lucide="briefcase" class="w-6 h-6"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900">No Postings Created Yet</h3>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">Once your company profile is approved, create job and internship postings with custom eligibility rules.</p>
          <% if (company && company.status === 'approved') { %>
            <div class="pt-2">
              <a href="/recruiter/postings/new" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-600 text-white text-xs font-semibold hover:bg-brand-700 transition-colors shadow-xs">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                Create First Posting
              </a>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
