<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col page-bg text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <!-- Back Navigation -->
    <div>
      <a href="/student/applications" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
        <i class="ph-bold ph-arrow-left w-3.5 h-3.5"></i>
        Back to Applications List
      </a>
    </div>

    <!-- Application Summary Header -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2">
            <span class="badge <%= application.type === 'job' ? 'badge-job' : 'badge-internship' %>">
              <%= application.type %>
            </span>
            <span class="text-xs text-slate-500 flex items-center gap-1">
              <i class="ph-bold ph-buildings w-3.5 h-3.5 text-slate-400"></i>
              <%= application.company_name %>
            </span>
          </div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-900">
            <%= application.title %>
          </h1>
          <p class="text-xs text-slate-500">
            Application ID: #<%= application.id %> &bull; Submitted on <%= new Date(application.applied_at).toLocaleDateString() %>
          </p>
        </div>

        <!-- Current Status Highlight Card -->
        <div class="flex items-center gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200 shrink-0">
          <div class="space-y-1 text-right sm:text-left">
            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Current Status</span>
            <span class="badge badge-<%= application.status %> text-sm py-1 px-3">
              <span class="badge-dot"></span>
              <%= application.status.replace('_', ' ') %>
            </span>
          </div>
        </div>
      </div>

      <!-- Pipeline Step Indicators -->
      <% 
        const stages = ['applied', 'under_review', 'shortlisted', 'interview', 'offered'];
        const currentIdx = stages.indexOf(application.status);
        const isRejected = application.status === 'rejected';
      %>
      <div class="mt-8 pt-6 border-t border-slate-100">
        <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-4">Pipeline Milestones</div>
        <div class="grid grid-cols-5 gap-2 text-center text-xs">
        <% stages.forEach((stage, idx) => { 
            let stateClass = 'bg-slate-100 text-slate-400 border-slate-200';
            let phIcon = 'ph-circle';
            if (isRejected) {
              if (idx <= (currentIdx >= 0 ? currentIdx : 0)) {
                stateClass = 'bg-slate-100 text-slate-500 border-slate-200';
                phIcon = 'ph-check';
              }
            } else if (idx < currentIdx) {
              stateClass = 'bg-emerald-50 text-emerald-700 border-emerald-300 font-semibold';
              phIcon = 'ph-check-circle';
            } else if (idx === currentIdx) {
              stateClass = 'bg-brand-50 text-brand-700 border-brand-400 font-bold ring-2 ring-brand-500/20';
              phIcon = 'ph-record';
            }
          %>
            <div class="p-2.5 rounded-xl border <%= stateClass %> flex flex-col items-center justify-center gap-1 transition-all">
              <i class="ph-bold <%= phIcon %> w-4 h-4"></i>
              <span class="capitalize text-[11px] leading-tight"><%= stage.replace('_', ' ') %></span>
            </div>
          <% }); %>
        </div>

        <% if (isRejected) { %>
          <div class="mt-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 text-xs flex items-center gap-2">
            <i class="ph-bold ph-x-circle w-4 h-4 text-rose-600 shrink-0"></i>
            <span>This application has been marked as <strong>Rejected</strong>. Check the timeline notes below for recruiter feedback.</span>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Chronological Application History Timeline -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-6">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <i class="ph-bold ph-git-commit w-4 h-4 text-brand-600"></i>
          Application Activity Timeline
        </h2>
        <span class="text-xs text-slate-500"><%= history ? history.length : 0 %> updates recorded</span>
      </div>

      <% if (history && history.length > 0) { %>
        <div class="timeline-track pt-2">
          <% history.forEach((item, idx) => { %>
            <div class="timeline-node">
              
              <!-- Marker Icon -->
              <div class="timeline-marker">
                <span class="w-2 h-2 rounded-full <%= item.to_status === 'offered' ? 'bg-emerald-600' : (item.to_status === 'rejected' ? 'bg-rose-600' : 'bg-brand-600') %>"></span>
              </div>

              <!-- Node Content -->
              <div class="space-y-2">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-bold text-slate-900 text-sm">
                      <%= item.from_status ? (item.from_status.replace('_', ' ') + ' → ' + item.to_status.replace('_', ' ')) : 'Application Submitted' %>
                    </span>
                    <span class="badge badge-<%= item.to_status %>">
                      <%= item.to_status.replace('_', ' ') %>
                    </span>
                  </div>
                  <span class="text-slate-400 text-[11px]">
                    <%= new Date(item.changed_at).toLocaleString() %>
                  </span>
                </div>

                <!-- Reviewer Notes / Feedback -->
                <% if (item.note && item.note.trim()) { %>
                  <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-slate-700 leading-relaxed space-y-1">
                    <span class="font-semibold text-slate-900 flex items-center gap-1.5 text-[11px] text-slate-500">
                      <i class="ph-bold ph-chat-text w-3.5 h-3.5 text-slate-400"></i>
                      Recruiter Note / Feedback:
                    </span>
                    <p class="text-slate-800"><%= item.note %></p>
                  </div>
                <% } %>

                <% if (item.changed_by_email) { %>
                  <div class="text-[10px] text-slate-400">
                    Updated by: <%= item.changed_by_email %>
                  </div>
                <% } %>
              </div>

            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="py-8 text-center text-xs text-slate-400">
          No history records found for this application.
        </div>
      <% } %>
    </div>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
