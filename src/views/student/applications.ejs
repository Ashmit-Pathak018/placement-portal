<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Application Tracking Pipeline</h1>
        <p class="text-xs text-slate-500 mt-1">Monitor your recruitment journey across all submitted job and internship opportunities.</p>
      </div>
      <a href="/student/postings" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-xl bg-brand-600 hover:bg-brand-700 text-white shadow-xs transition-colors self-start sm:self-auto">
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        Browse New Opportunities
      </a>
    </div>

    <!-- Applications Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden">
      <% if (applications && applications.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200/80 text-[11px] font-semibold text-slate-500 uppercase tracking-wider">
                <th class="py-3.5 px-6">Opportunity & Organization</th>
                <th class="py-3.5 px-4">Applied Date</th>
                <th class="py-3.5 px-4">Current Pipeline Stage</th>
                <th class="py-3.5 px-4">Last Activity</th>
                <th class="py-3.5 px-6 text-right">Details</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs">
              <% applications.forEach(app => { %>
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="py-4 px-6">
                    <div class="font-bold text-slate-900 text-sm"><%= app.title %></div>
                    <div class="text-slate-500 flex items-center gap-1 mt-0.5">
                      <i data-lucide="building-2" class="w-3 h-3 text-slate-400"></i>
                      <%= app.company_name %>
                    </div>
                  </td>
                  <td class="py-4 px-4 text-slate-600 whitespace-nowrap">
                    <%= new Date(app.applied_at).toLocaleDateString() %>
                  </td>
                  <td class="py-4 px-4 whitespace-nowrap">
                    <span class="badge badge-<%= app.status %>">
                      <span class="badge-dot"></span>
                      <%= app.status.replace('_', ' ') %>
                    </span>
                  </td>
                  <td class="py-4 px-4 text-slate-500 whitespace-nowrap">
                    <%= new Date(app.updated_at).toLocaleDateString() %>
                  </td>
                  <td class="py-4 px-6 text-right whitespace-nowrap">
                    <a href="/student/applications/<%= app.id %>"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 font-semibold text-slate-700 shadow-xs transition-colors">
                      <span>View Timeline</span>
                      <i data-lucide="arrow-right" class="w-3 h-3"></i>
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="p-12 text-center space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
            <i data-lucide="inbox" class="w-6 h-6"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900">No Applications Submitted Yet</h3>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">Browse active recruitment postings and apply to roles you are eligible for to start tracking your progress here.</p>
          <div class="pt-2">
            <a href="/student/postings" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-600 text-white text-xs font-semibold hover:bg-brand-700 transition-colors shadow-xs">
              <i data-lucide="search" class="w-3.5 h-3.5"></i>
              Browse Job Postings
            </a>
          </div>
        </div>
      <% } %>
    </div>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
