<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <%- include('../partials/flash') %>

    <!-- Welcome Hero Section -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2">
          <div class="flex items-center gap-2.5">
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
              Welcome back, <%= student && student.name ? student.name : 'Student' %>!
            </h1>
            <% if (student && student.cgpa > 0) { %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200">
                Batch <%= student.grad_year %>
              </span>
            <% } %>
          </div>
          <p class="text-sm text-slate-600">
            <% if (student && student.branch) { %>
              Enrolled in <strong class="text-slate-900"><%= student.branch %></strong> &bull; CGPA: <strong class="text-slate-900"><%= student.cgpa.toFixed(2) %></strong>
            <% } else { %>
              Complete your profile to unlock eligibility gating and job applications.
            <% } %>
          </p>
        </div>

        <!-- Quick Profile Status & Action -->
        <% 
          let completedFields = 0;
          if (student) {
            if (student.name) completedFields++;
            if (student.branch) completedFields++;
            if (student.cgpa > 0) completedFields++;
            if (student.grad_year > 0) completedFields++;
            if (student.resume_url) completedFields++;
          }
          const completionPct = Math.round((completedFields / 5) * 100);
        %>
        <div class="flex items-center gap-4 bg-slate-50 rounded-xl p-3.5 border border-slate-200/80">
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs gap-3">
              <span class="font-medium text-slate-600">Profile Readiness</span>
              <span class="font-bold text-slate-900"><%= completionPct %>%</span>
            </div>
            <div class="w-36 h-2 bg-slate-200 rounded-full overflow-hidden">
              <div class="h-full bg-brand-600 rounded-full" style="width: <%= completionPct %>%"></div>
            </div>
          </div>
          <a href="/student/profile" class="px-3.5 py-2 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 shadow-xs transition-colors flex items-center gap-1.5 whitespace-nowrap">
            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
            Edit
          </a>
        </div>
      </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <!-- Total Applications -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 flex items-center justify-between">
        <div class="space-y-1">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Applications</span>
          <div class="text-3xl font-extrabold text-slate-900"><%= stats.total %></div>
          <span class="text-xs text-slate-500">Submitted across portal</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
          <i data-lucide="clipboard-list" class="w-6 h-6"></i>
        </div>
      </div>

      <!-- In Progress / Review -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 flex items-center justify-between">
        <div class="space-y-1">
          <span class="text-xs font-semibold text-amber-700 uppercase tracking-wider">In Active Review</span>
          <div class="text-3xl font-extrabold text-amber-600"><%= stats.pending %></div>
          <span class="text-xs text-slate-500">Screening & interviews</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
          <i data-lucide="clock" class="w-6 h-6"></i>
        </div>
      </div>

      <!-- Offers -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 flex items-center justify-between">
        <div class="space-y-1">
          <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">Offers Received</span>
          <div class="text-3xl font-extrabold text-emerald-600"><%= stats.offered %></div>
          <span class="text-xs text-slate-500">Placement selections</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <i data-lucide="award" class="w-6 h-6"></i>
        </div>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column (2 Cols): Recommended Opportunities & Applications -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Recommended For You (USP Match Score) -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden">
          <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
              </div>
              <div>
                <h2 class="text-base font-bold text-slate-900">Recommended for You</h2>
                <p class="text-xs text-slate-500">Ranked by rule-based match score (Branch, CGPA, Batch & Urgency)</p>
              </div>
            </div>
            <a href="/student/postings" class="text-xs font-semibold text-brand-600 hover:text-brand-700 hover:underline flex items-center gap-1">
              View all <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>

          <div class="p-6 divide-y divide-slate-100">
            <% if (recommended && recommended.length > 0) { %>
              <div class="space-y-4">
                <% recommended.forEach(job => { %>
                  <div class="p-4 rounded-xl border border-slate-100 hover:border-slate-300 hover:shadow-sm bg-slate-50/50 hover:bg-white transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="space-y-1.5 flex-1 min-w-0">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-bold text-slate-900 text-sm hover:text-brand-600 transition-colors">
                          <a href="/student/postings/<%= job.id %>"><%= job.title %></a>
                        </span>
                        <span class="badge <%= job.type === 'job' ? 'badge-job' : 'badge-internship' %>">
                          <%= job.type %>
                        </span>
                      </div>
                      <div class="text-xs text-slate-500 flex items-center gap-3 flex-wrap">
                        <span class="font-medium text-slate-700 flex items-center gap-1">
                          <i data-lucide="building" class="w-3.5 h-3.5 text-slate-400"></i>
                          <%= job.company_name %>
                        </span>
                        <span>&bull;</span>
                        <span>Min CGPA: <strong><%= job.min_cgpa %></strong></span>
                        <span>&bull;</span>
                        <span class="text-rose-600 font-medium flex items-center gap-1">
                          <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                          Deadline: <%= new Date(job.deadline).toLocaleDateString() %>
                        </span>
                      </div>
                    </div>

                    <!-- Match Score Gauge & Button -->
                    <div class="flex items-center gap-4 shrink-0">
                      <div class="flex flex-col items-end">
                        <div class="flex items-center gap-1.5">
                          <span class="text-xs font-bold <%= job.match_score >= 70 ? 'text-emerald-600' : (job.match_score >= 40 ? 'text-brand-600' : 'text-slate-500') %>">
                            <%= job.match_score %>% Match
                          </span>
                        </div>
                        <div class="w-20 h-1.5 bg-slate-200 rounded-full overflow-hidden mt-1">
                          <div class="h-full <%= job.match_score >= 70 ? 'bg-emerald-500' : (job.match_score >= 40 ? 'bg-brand-500' : 'bg-slate-400') %>"
                               style="width: <%= job.match_score %>%"></div>
                        </div>
                      </div>

                      <a href="/student/postings/<%= job.id %>" class="px-3.5 py-2 rounded-lg bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800 transition-colors shadow-xs">
                        View Role
                      </a>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="py-8 text-center text-xs text-slate-400">
                No active approved postings found at this time.
              </div>
            <% } %>
          </div>
        </div>

        <!-- Recent Applications Table -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden">
          <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center">
                <i data-lucide="history" class="w-4 h-4"></i>
              </div>
              <h2 class="text-base font-bold text-slate-900">Recent Applications</h2>
            </div>
            <a href="/student/applications" class="text-xs font-semibold text-brand-600 hover:text-brand-700 hover:underline flex items-center gap-1">
              View tracking pipeline <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>

          <div class="overflow-x-auto">
            <% if (recentApps && recentApps.length > 0) { %>
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-slate-50/70 border-b border-slate-100 text-[11px] font-semibold text-slate-500 uppercase tracking-wider">
                    <th class="py-3 px-6">Opportunity</th>
                    <th class="py-3 px-4">Applied Date</th>
                    <th class="py-3 px-4">Status</th>
                    <th class="py-3 px-6 text-right">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs">
                  <% recentApps.forEach(app => { %>
                    <tr class="hover:bg-slate-50/60 transition-colors">
                      <td class="py-3.5 px-6">
                        <div class="font-bold text-slate-900"><%= app.title %></div>
                        <div class="text-slate-500"><%= app.company_name %></div>
                      </td>
                      <td class="py-3.5 px-4 text-slate-600 whitespace-nowrap">
                        <%= new Date(app.applied_at).toLocaleDateString() %>
                      </td>
                      <td class="py-3.5 px-4 whitespace-nowrap">
                        <span class="badge badge-<%= app.status %>">
                          <span class="badge-dot"></span>
                          <%= app.status.replace('_', ' ') %>
                        </span>
                      </td>
                      <td class="py-3.5 px-6 text-right whitespace-nowrap">
                        <a href="/student/applications/<%= app.id %>" class="font-semibold text-brand-600 hover:text-brand-700 hover:underline">
                          Timeline &rarr;
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } else { %>
              <div class="py-8 text-center text-xs text-slate-400">
                You have not applied to any job postings yet. <a href="/student/postings" class="text-brand-600 underline">Browse active jobs</a>.
              </div>
            <% } %>
          </div>
        </div>

      </div>

      <!-- Right Column (1 Col): Notifications & Advisory Notice -->
      <div class="space-y-8">
        
        <!-- Notifications Card -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="bell" class="w-4 h-4 text-brand-600"></i>
              Activity Feed
            </h3>
            <form action="/student/notifications/read-all" method="POST" class="inline m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="text-[11px] font-semibold text-slate-500 hover:text-slate-900">
                Mark read
              </button>
            </form>
          </div>

          <div class="space-y-3 max-h-80 overflow-y-auto">
            <% if (notifications && notifications.length > 0) { %>
              <% notifications.forEach(n => { %>
                <div class="p-3 rounded-xl <%= n.is_read ? 'bg-slate-50 border border-slate-100 opacity-80' : 'bg-brand-50/40 border border-brand-100' %> transition-all text-xs space-y-1">
                  <div class="text-slate-800 font-medium leading-relaxed">
                    <% if (n.link) { %>
                      <a href="<%= n.link %>" class="hover:text-brand-600 hover:underline"><%= n.message %></a>
                    <% } else { %>
                      <%= n.message %>
                    <% } %>
                  </div>
                  <div class="text-[10px] text-slate-400">
                    <%= new Date(n.created_at).toLocaleString() %>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="py-6 text-center text-xs text-slate-400">
                No recent notifications.
              </div>
            <% } %>
          </div>
        </div>

        <!-- Institutional Placement Cell Notice -->
        <div class="bg-gradient-to-br from-slate-900 to-indigo-950 text-white rounded-2xl p-6 shadow-card space-y-3">
          <div class="flex items-center gap-2 text-xs font-semibold tracking-wider uppercase text-brand-300">
            <i data-lucide="shield-check" class="w-4 h-4"></i>
            Transparency & Gating Policy
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">
            All applications are automatically checked against recruiter CGPA cutoffs, batch year, and eligible academic departments. If ineligible, the system explains every factor clearly.
          </p>
          <div class="pt-1">
            <a href="/student/postings" class="inline-flex items-center gap-1.5 text-xs font-semibold text-white bg-white/10 hover:bg-white/20 px-3.5 py-2 rounded-lg transition-colors">
              Explore Openings <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>

      </div>

    </div>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
