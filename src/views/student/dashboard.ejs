<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — CampusPlace</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container">
    <%- include('../partials/flash') %>
    
    <h2>Welcome, <%= student.name %>!</h2>
    
    <div class="stats-grid">
      <div class="stat-card">
        <h3>Total Applications</h3>
        <p><%= stats.total %></p>
      </div>
      <div class="stat-card">
        <h3>Pending Applications</h3>
        <p><%= stats.pending %></p>
      </div>
      <div class="stat-card">
        <h3>Offers Received</h3>
        <p><%= stats.offered %></p>
      </div>
    </div>

    <div class="dashboard-grid">
      <section>
        <h3>Recommended for You</h3>
        <% if (recommended && recommended.length > 0) { %>
          <div class="card-list">
            <% recommended.forEach(posting => { %>
              <div class="card">
                <h4><%= posting.title %> @ <%= posting.company_name %></h4>
                <div class="match-score">
                  <span>Match Score: <%= posting.match_score %>%</span>
                  <div class="progress-bar">
                    <div class="progress" style="width: <%= posting.match_score %>%"></div>
                  </div>
                </div>
                <a href="/student/postings/<%= posting.id %>" class="btn btn-sm">View Details</a>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p>No recommendations available right now.</p>
        <% } %>
      </section>

      <section>
        <h3>Recent Applications</h3>
        <% if (recentApps && recentApps.length > 0) { %>
          <table class="table">
            <thead>
              <tr>
                <th>Role</th>
                <th>Company</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% recentApps.forEach(app => { %>
                <tr>
                  <td><a href="/student/applications/<%= app.id %>"><%= app.title %></a></td>
                  <td><%= app.company_name %></td>
                  <td><span class="badge status-<%= app.status %>"><%= app.status %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <a href="/student/applications" class="btn btn-sm">View All Applications</a>
        <% } else { %>
          <p>You haven't applied to any postings yet.</p>
        <% } %>
      </section>
    </div>

    <section class="notifications-section">
      <div class="flex-between">
        <h3>Notifications</h3>
        <form action="/student/notifications/read-all" method="POST" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-outline">Mark all as read</button>
        </form>
      </div>
      <% if (notifications && notifications.length > 0) { %>
        <ul class="notification-list">
          <% notifications.forEach(note => { %>
            <li class="notification <%= note.is_read ? 'read' : 'unread' %>">
              <p><%= note.message %></p>
              <small><%= new Date(note.created_at).toLocaleString() %></small>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No new notifications.</p>
      <% } %>
    </section>

  </main>
  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
