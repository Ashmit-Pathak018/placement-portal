<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — CampusPlace</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container">
    <%- include('../partials/flash') %>
    
    <div class="posting-header">
      <h2><%= posting.title %></h2>
      <h3><%= posting.company_name %></h3>
      <div class="badges">
        <span class="badge"><%= posting.type %></span>
        <span class="badge">Deadline: <%= new Date(posting.deadline).toLocaleDateString() %></span>
      </div>
    </div>

    <div class="grid-2">
      <div class="main-details">
        <section class="card">
          <h4>Description</h4>
          <p><%= posting.description %></p>
        </section>

        <section class="card">
          <h4>Requirements</h4>
          <ul>
            <li><strong>Min CGPA:</strong> <%= posting.min_cgpa %></li>
            <li><strong>Graduation Year:</strong> <%= posting.grad_year %></li>
            <li><strong>Eligible Branches:</strong> <%= posting.allowed_branches.join(', ') || 'None' %></li>
          </ul>
        </section>

        <section class="card">
          <h4>Match Score Breakdown (<%= match.score || match.total || 0 %>%)</h4>
          <ul>
            <% if (Array.isArray(match.breakdown)) { %>
              <% match.breakdown.forEach(item => { %>
                <li><strong><%= item.label %>:</strong> <%= item.points %> pts — <small><%= item.detail %></small></li>
              <% }) %>
            <% } else { %>
              <li>Branch match, CGPA margin, Grad year, Urgency evaluated.</li>
            <% } %>
          </ul>
        </section>
      </div>

      <div class="sidebar">
        <section class="card eligibility-card <%= eligibility.eligible ? 'border-green' : 'border-red' %>">
          <h4>Eligibility Status</h4>
          <% if (eligibility.eligible) { %>
            <p style="color: green; font-weight: bold;">✔️ You are eligible for this role.</p>
            
            <% if (existingApp) { %>
              <div class="alert alert-info">
                You have already applied. Current status: <strong><%= existingApp.status %></strong>
              </div>
              <a href="/student/applications/<%= existingApp.id %>" class="btn btn-outline">View Application</a>
            <% } else { %>
              <form action="/student/postings/<%= posting.id %>/apply" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-primary btn-full">Apply Now</button>
              </form>
            <% } %>

          <% } else { %>
            <p style="color: red; font-weight: bold;">❌ You are not eligible.</p>
            <ul style="color: red;">
              <% (eligibility.reasons || []).forEach(reason => { %>
                <li><%= reason %></li>
              <% }) %>
            </ul>
          <% } %>
        </section>

        <section class="card">
          <h4>What-If Checker</h4>
          <p><small>Check hypothetical eligibility if your stats change.</small></p>
          <form id="whatIfForm" action="/student/what-if/<%= posting.id %>" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
              <label>Hypothetical CGPA</label>
              <input type="number" step="0.01" name="cgpa" required>
            </div>
            <div class="form-group">
              <label>Branch</label>
              <select name="branch" required>
                <% const branchOpts = ['CSE', 'ECE', 'EEE', 'ME', 'CE', 'IT', 'CHE', 'BT']; %>
                <% branchOpts.forEach(b => { %>
                  <option value="<%= b %>"><%= b %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label>Grad Year</label>
              <input type="number" name="grad_year" required>
            </div>
            <button type="submit" class="btn btn-sm btn-outline">Check</button>
          </form>
          <div id="whatIfResult" style="margin-top: 10px;"></div>
        </section>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
  
  <script>
    document.getElementById('whatIfForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = new URLSearchParams(new FormData(form));
      
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
          },
          body: data
        });
        const result = await res.json();
        const resultDiv = document.getElementById('whatIfResult');
        
        if (result.eligible) {
          resultDiv.innerHTML = '<span style="color:green;">Would be eligible!</span>';
        } else {
          resultDiv.innerHTML = '<span style="color:red;">Ineligible: ' + result.reasons.join(', ') + '</span>';
        }
      } catch (err) {
        console.error(err);
      }
    });
  </script>
</body>
</html>
