<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col page-bg text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <!-- Back Navigation -->
    <div>
      <a href="/student/postings" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
        <i class="ph-bold ph-arrow-left w-3.5 h-3.5"></i>
        Back to Opportunities
      </a>
    </div>

    <!-- Header Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2">
          <div class="flex items-center gap-2.5 flex-wrap">
            <span class="badge <%= posting.type === 'job' ? 'badge-job' : 'badge-internship' %>">
              <%= posting.type %>
            </span>
            <span class="text-xs font-semibold text-slate-500 flex items-center gap-1">
              <i class="ph-bold ph-buildings w-3.5 h-3.5 text-slate-400"></i>
              <%= posting.company_name %>
            </span>
            <span class="text-xs text-slate-400">&bull;</span>
            <span class="text-xs text-rose-600 font-semibold flex items-center gap-1">
              <i class="ph-bold ph-calendar w-3.5 h-3.5"></i>
              Deadline: <%= new Date(posting.deadline).toLocaleDateString() %>
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            <%= posting.title %>
          </h1>
        </div>

        <!-- Overall Match Score Pill -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 flex items-center gap-4 shrink-0">
          <div class="space-y-1">
            <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Smart Match Score</div>
            <div class="text-2xl font-extrabold <%= match.score >= 70 ? 'text-emerald-600' : (match.score >= 40 ? 'text-brand-600' : 'text-slate-700') %>">
              <%= match.score %>%
            </div>
          </div>
          <div class="w-16 h-2 bg-slate-200 rounded-full overflow-hidden">
            <div class="h-full <%= match.score >= 70 ? 'bg-emerald-500' : (match.score >= 40 ? 'bg-brand-500' : 'bg-slate-400') %>"
                 style="width: <%= match.score %>%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2-Column Grid: Details vs Eligibility & What-If -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Column (7 Cols): Role Description & Match Score Explainer -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Job Description -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-4">
          <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <i class="ph-bold ph-file-text w-4 h-4 text-brand-600"></i>
            Role Description & Scope
          </h2>
          <div class="text-sm text-slate-700 leading-relaxed whitespace-pre-line">
            <%= posting.description %>
          </div>
        </div>

        <!-- Key Academic Criteria -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-4">
          <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <i class="ph-bold ph-check-square w-4 h-4 text-brand-600"></i>
            Eligibility Requirements
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
              <span class="text-slate-500 block">Cutoff Minimum CGPA</span>
              <span class="text-base font-bold text-slate-900"><%= posting.min_cgpa.toFixed(2) %></span>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
              <span class="text-slate-500 block">Target Batch Year</span>
              <span class="text-base font-bold text-slate-900"><%= posting.grad_year ? posting.grad_year : 'Any Batch' %></span>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
              <span class="text-slate-500 block">Role Type</span>
              <span class="text-base font-bold text-slate-900 capitalize"><%= posting.type %></span>
            </div>
          </div>

          <div class="space-y-1.5 pt-2">
            <span class="text-xs font-semibold text-slate-500">Eligible Departments:</span>
            <div class="flex items-center gap-2 flex-wrap">
              <% if (posting.allowed_branches && posting.allowed_branches.length > 0) { %>
                <% posting.allowed_branches.forEach(b => { %>
                  <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                    <%= b %>
                  </span>
                <% }); %>
              <% } else { %>
                <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700">Open to All Departments</span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Match Score Breakdown ("Why this match?") -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <i class="ph-bold ph-chart-pie-slice w-4 h-4 text-brand-600"></i>
              Why this match score?
            </h2>
            <span class="text-xs font-bold text-slate-700">Total: <%= match.score %>/100</span>
          </div>
          <p class="text-xs text-slate-500">Transparent algorithmic calculation based on objective criteria.</p>

          <div class="space-y-3 pt-2">
            <% if (Array.isArray(match.breakdown)) { %>
              <% match.breakdown.forEach(factor => { %>
                <div class="p-3.5 rounded-xl border border-slate-100 bg-slate-50/60 flex items-start justify-between gap-4">
                  <div class="space-y-1">
                    <span class="text-xs font-bold text-slate-900"><%= factor.label %></span>
                    <p class="text-xs text-slate-600"><%= factor.detail %></p>
                  </div>
                  <span class="px-2 py-0.5 rounded-md text-xs font-bold <%= factor.points > 0 ? 'bg-brand-50 text-brand-700' : 'bg-slate-100 text-slate-500' %> shrink-0">
                    +<%= factor.points %> pts
                  </span>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>

      </div>

      <!-- Right Column (5 Cols): ELIGIBILITY PANEL & WHAT-IF SIMULATOR -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- ELIGIBILITY PANEL (Core USP) -->
        <div class="bg-white rounded-2xl border <%= eligibility.eligible ? 'border-emerald-200 ring-2 ring-emerald-500/10' : 'border-rose-200 ring-2 ring-rose-500/10' %> shadow-card p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-xl <%= eligibility.eligible ? 'bg-emerald-100 text-emerald-600' : 'bg-rose-100 text-rose-600' %> flex items-center justify-center">
                <i class="ph-bold <%= eligibility.eligible ? 'ph-shield-check' : 'ph-shield-warning' %> w-5 h-5"></i>
              </div>
              <h2 class="text-base font-bold text-slate-900">Eligibility Status</h2>
            </div>
            <span class="badge <%= eligibility.eligible ? 'badge-approved' : 'badge-rejected' %>">
              <%= eligibility.eligible ? 'Eligible' : 'Blocked' %>
            </span>
          </div>

          <!-- Explanatory Notice Checklist -->
          <div class="space-y-3">
            <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Server Verification Checklist</div>

            <% if (eligibility.eligible) { %>
              <div class="p-4 rounded-xl bg-emerald-50/80 border border-emerald-200 text-emerald-900 text-xs space-y-1">
                <div class="font-bold flex items-center gap-1.5 text-emerald-800">
                  <i class="ph-bold ph-check w-4 h-4 text-emerald-600"></i>
                  You meet all candidate requirements
                </div>
                <p class="text-emerald-700 text-[11px]">Your CGPA, department, and graduation batch satisfy the recruiter's criteria.</p>
              </div>
            <% } else { %>
              <div class="p-4 rounded-xl bg-rose-50/80 border border-rose-200 text-rose-900 text-xs space-y-2">
                <div class="font-bold flex items-center gap-1.5 text-rose-800">
                  <i class="ph-bold ph-warning-circle w-4 h-4 text-rose-600"></i>
                  You are not eligible for this opportunity
                </div>
                <ul class="space-y-1 text-rose-700 text-[11px] list-disc pl-4">
                  <% (eligibility.reasons || []).forEach(r => { %>
                    <li><%= r %></li>
                  <% }); %>
                </ul>
              </div>
            <% } %>
          </div>

          <!-- Application Action Area -->
          <div class="pt-4 border-t border-slate-100">
            <% if (existingApp) { %>
              <div class="p-4 rounded-xl bg-indigo-50 border border-indigo-200 text-xs space-y-2 text-indigo-900">
                <div class="font-bold flex items-center gap-1.5 text-indigo-800">
                  <i class="ph-bold ph-check-circle w-4 h-4 text-indigo-600"></i>
                  Application Already Submitted
                </div>
                <p class="text-[11px] text-indigo-700">
                  Current Status: <span class="badge badge-<%= existingApp.status %> ml-1"><%= existingApp.status %></span>
                </p>
                <div class="pt-1">
                  <a href="/student/applications/<%= existingApp.id %>" class="inline-flex items-center gap-1 font-semibold text-brand-600 hover:text-brand-700 hover:underline">
                    View tracking timeline &rarr;
                  </a>
                </div>
              </div>
            <% } else if (eligibility.eligible) { %>
              <form action="/student/postings/<%= posting.id %>/apply" method="POST" class="space-y-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit"
                  class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-sm hover:shadow transition-all">
                  <i class="ph-bold ph-paper-plane-tilt w-4 h-4"></i>
                  Submit Application Now
                </button>
                <p class="text-[11px] text-slate-400 text-center">Your academic profile will be transmitted directly to the recruiter.</p>
              </form>
            <% } else { %>
              <button type="button" disabled
                class="w-full py-3 px-4 rounded-xl bg-slate-100 text-slate-400 text-sm font-semibold cursor-not-allowed text-center border border-slate-200 flex items-center justify-center gap-2">
                <i class="ph-bold ph-minus w-4 h-4"></i>
                Application Blocked (Ineligible)
              </button>
              <p class="text-[11px] text-slate-400 text-center mt-2">See what changes would make you eligible using the simulator below.</p>
            <% } %>
          </div>
        </div>

        <!-- WHAT-IF ELIGIBILITY SIMULATOR (USP) -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8 space-y-4">
          <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
            <div class="w-8 h-8 rounded-xl bg-indigo-50 text-brand-600 flex items-center justify-center">
              <i class="ph-bold ph-calculator w-4 h-4"></i>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">What-If Eligibility Simulator</h3>
              <p class="text-[11px] text-slate-400">Hypothetical test only &bull; Does NOT alter your profile</p>
            </div>
          </div>

          <form id="whatIfForm" action="/student/what-if/<%= posting.id %>" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div>
              <label for="whatif-cgpa" class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                Hypothetical CGPA
              </label>
              <input type="number" id="whatif-cgpa" name="cgpa" step="0.01" min="0" max="10" required
                value="<%= posting.min_cgpa %>"
                class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all">
            </div>

            <div>
              <label for="whatif-branch" class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                Department
              </label>
              <select id="whatif-branch" name="branch" required
                class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all">
                <% const branchList = branches || ['CSE', 'ECE', 'EEE', 'ME', 'CE', 'IT', 'CHE', 'BT']; %>
                <% branchList.forEach(b => { %>
                  <option value="<%= b %>"><%= b %></option>
                <% }); %>
              </select>
            </div>

            <div>
              <label for="whatif-grad" class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                Batch Year
              </label>
              <input type="number" id="whatif-grad" name="grad_year" required
                value="<%= posting.grad_year || new Date().getFullYear() %>"
                class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all">
            </div>

            <button type="submit"
              class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-xs transition-colors flex items-center justify-center gap-1.5">
              <i class="ph-bold ph-play w-3.5 h-3.5"></i>
              Simulate Result
            </button>
          </form>

          <!-- Interactive Result Container -->
          <div id="whatIfResult" class="hidden pt-3 border-t border-slate-100 text-xs"></div>
        </div>

      </div>

    </div>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
  <script>
    // AJAX Interactive What-If Simulator
    const whatIfForm = document.getElementById('whatIfForm');
    const whatIfResult = document.getElementById('whatIfResult');

    if (whatIfForm) {
      whatIfForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new URLSearchParams(new FormData(whatIfForm));
        
        try {
          const res = await fetch(whatIfForm.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'Accept': 'application/json'
            },
            body: data
          });
          const result = await res.json();
          whatIfResult.classList.remove('hidden');

          function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
          }

          if (result.eligible) {
            whatIfResult.innerHTML = `
              <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 flex items-start gap-2">
                <i class="ph-bold ph-check-circle w-4 h-4 text-emerald-600 shrink-0 mt-0.5"></i>
                <div>
                  <strong class="block text-emerald-800">Simulation: Eligible!</strong>
                  <span class="text-[11px] text-emerald-700">With these hypothetical credentials, you WOULD meet the eligibility criteria for this role.</span>
                </div>
              </div>
            `;
          } else {
            whatIfResult.innerHTML = `
              <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 flex items-start gap-2">
                <i class="ph-bold ph-x-circle w-4 h-4 text-rose-600 shrink-0 mt-0.5"></i>
                <div class="space-y-1">
                  <strong class="block text-rose-800">Simulation: Ineligible</strong>
                  <ul class="list-disc pl-4 text-[11px] text-rose-700 space-y-0.5">
                    ${(result.reasons || []).map(r => `<li>${escapeHtml(r)}</li>`).join('')}
                  </ul>
                </div>
              </div>
            `;
          }
        } catch (err) {
          console.error(err);
        }
      });
    }
  </script>
</body>
</html>
