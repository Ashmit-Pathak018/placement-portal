<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Placement & Internship Opportunities</h1>
        <p class="text-xs text-slate-500 mt-1">Explore verified roles approved by the Placement Cell. Server-side eligibility applies automatically.</p>
      </div>
      <div class="text-xs text-slate-500 bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs flex items-center gap-1.5 self-start sm:self-auto">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600"></i>
        <span><%= postings ? postings.filter(p => p.eligible).length : 0 %> Eligible for you</span>
      </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-4">
      <form class="grid grid-cols-1 sm:grid-cols-12 gap-3" action="/student/postings" method="GET">
        
        <!-- Search Keyword -->
        <div class="sm:col-span-5 relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <i data-lucide="search" class="w-4 h-4"></i>
          </div>
          <input type="text" name="search" placeholder="Search role title, company..." value="<%= filters.search || '' %>"
            class="w-full pl-10 pr-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
        </div>

        <!-- Department Filter -->
        <div class="sm:col-span-3">
          <select name="branch"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
            <option value="">All Departments</option>
            <% const branchOpts = branches || ['CSE', 'ECE', 'EEE', 'ME', 'CE', 'IT', 'CHE', 'BT']; %>
            <% branchOpts.forEach(b => { %>
              <option value="<%= b %>" <%= filters.branch === b ? 'selected' : '' %>><%= b %></option>
            <% }); %>
          </select>
        </div>

        <!-- Role Type Filter -->
        <div class="sm:col-span-2">
          <select name="type"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
            <option value="">All Types</option>
            <option value="job" <%= filters.type === 'job' ? 'selected' : '' %>>Full-Time Job</option>
            <option value="internship" <%= filters.type === 'internship' ? 'selected' : '' %>>Internship</option>
          </select>
        </div>

        <!-- Filter Actions -->
        <div class="sm:col-span-2 flex items-center gap-2">
          <button type="submit" class="flex-1 py-2 px-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-xs transition-colors text-center">
            Filter
          </button>
          <a href="/student/postings" class="py-2 px-3 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-xs font-semibold transition-colors text-center" title="Reset filters">
            Reset
          </a>
        </div>

      </form>
    </div>

    <!-- Postings Cards Grid / List -->
    <% if (postings && postings.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <% postings.forEach(posting => { %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-card hover:shadow-card-hover transition-all duration-200 p-6 flex flex-col justify-between space-y-4">
            
            <!-- Top Card Header -->
            <div class="space-y-3">
              <div class="flex items-start justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="badge <%= posting.type === 'job' ? 'badge-job' : 'badge-internship' %>">
                      <%= posting.type %>
                    </span>
                    <% if (posting.eligible) { %>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <i data-lucide="check" class="w-3 h-3 text-emerald-600"></i>
                        Eligible
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        <i data-lucide="x" class="w-3 h-3 text-rose-600"></i>
                        Ineligible
                      </span>
                    <% } %>
                  </div>
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-brand-600 transition-colors">
                    <a href="/student/postings/<%= posting.id %>"><%= posting.title %></a>
                  </h3>
                </div>

                <!-- Match Score Indicator -->
                <div class="text-right shrink-0">
                  <div class="text-xs font-bold <%= posting.match_score >= 70 ? 'text-emerald-600' : (posting.match_score >= 40 ? 'text-brand-600' : 'text-slate-500') %>">
                    <%= posting.match_score %>% Match
                  </div>
                  <div class="w-16 h-1.5 bg-slate-100 rounded-full overflow-hidden mt-1 ml-auto">
                    <div class="h-full <%= posting.match_score >= 70 ? 'bg-emerald-500' : (posting.match_score >= 40 ? 'bg-brand-500' : 'bg-slate-400') %>"
                         style="width: <%= posting.match_score %>%"></div>
                  </div>
                </div>
              </div>

              <!-- Company & Key Specs -->
              <div class="text-xs text-slate-500 flex items-center gap-2 flex-wrap">
                <span class="font-semibold text-slate-800 flex items-center gap-1">
                  <i data-lucide="building-2" class="w-3.5 h-3.5 text-slate-400"></i>
                  <%= posting.company_name %>
                </span>
                <span>&bull;</span>
                <span>Min CGPA: <strong class="text-slate-700"><%= posting.min_cgpa %></strong></span>
                <span>&bull;</span>
                <span class="text-rose-600 font-medium flex items-center gap-1">
                  <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                  <%= new Date(posting.deadline).toLocaleDateString() %>
                </span>
              </div>

              <!-- Eligible Branches Pills -->
              <div class="flex items-center gap-1.5 flex-wrap pt-1">
                <span class="text-[10px] text-slate-400 uppercase font-semibold">Eligible:</span>
                <% if (posting.allowed_branches && posting.allowed_branches.length > 0) { %>
                  <% posting.allowed_branches.forEach(br => { %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600">
                      <%= br %>
                    </span>
                  <% }); %>
                <% } else { %>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600">All Branches</span>
                <% } %>
              </div>
            </div>

            <!-- Card Bottom Action -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[11px] text-slate-400">
                <%= posting.grad_year ? 'Batch ' + posting.grad_year : 'Open Batch' %>
              </span>
              <a href="/student/postings/<%= posting.id %>"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold <%= posting.eligible ? 'bg-brand-600 hover:bg-brand-700 text-white shadow-xs' : 'bg-slate-100 hover:bg-slate-200 text-slate-700' %> transition-colors">
                View & Explain <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
              </a>
            </div>

          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
          <i data-lucide="search-x" class="w-6 h-6"></i>
        </div>
        <h3 class="text-base font-bold text-slate-900">No Postings Match Your Search</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">Try resetting or broadening your filters to explore other active campus recruitment opportunities.</p>
        <div>
          <a href="/student/postings" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 rounded-xl transition-colors">
            Clear Filters
          </a>
        </div>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
