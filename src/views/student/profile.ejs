<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-3xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <%- include('../partials/flash') %>

    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Academic & Placement Profile</h1>
        <p class="text-xs text-slate-500 mt-1">Keep your details up to date to ensure accurate eligibility gating and match scoring.</p>
      </div>
      <a href="/student/dashboard" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 rounded-lg shadow-xs hover:bg-slate-50 transition-colors">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
        Dashboard
      </a>
    </div>

    <% if (!student.name || !student.branch || !student.cgpa || !student.grad_year) { %>
      <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-start gap-3">
        <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-600 shrink-0 mt-0.5"></i>
        <div>
          <span class="font-bold">Incomplete Profile Notice:</span>
          Please fill out all required academic details below. Incomplete profiles will be blocked by the server-side eligibility gate when applying for job postings.
        </div>
      </div>
    <% } %>

    <!-- Profile Form Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-6 sm:p-8">
      <form action="/student/profile" method="POST" class="space-y-6">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          
          <!-- Full Name -->
          <div class="sm:col-span-2">
            <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Full Name <span class="text-rose-500">*</span>
            </label>
            <input type="text" id="name" name="name" value="<%= student.name || '' %>" required
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
              placeholder="e.g. Aarav Sharma">
          </div>

          <!-- Academic Branch -->
          <div>
            <label for="branch" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Department / Branch <span class="text-rose-500">*</span>
            </label>
            <select id="branch" name="branch" required
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
              <option value="">Select your department...</option>
              <% const branchList = branches || ['CSE', 'ECE', 'EEE', 'ME', 'CE', 'IT', 'CHE', 'BT']; %>
              <% branchList.forEach(b => { %>
                <option value="<%= b %>" <%= student.branch === b ? 'selected' : '' %>><%= b %></option>
              <% }); %>
            </select>
          </div>

          <!-- CGPA -->
          <div>
            <label for="cgpa" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Cumulative CGPA <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <input type="number" id="cgpa" name="cgpa" step="0.01" min="0" max="10" value="<%= student.cgpa || '' %>" required
                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
                placeholder="0.00 to 10.00">
            </div>
            <p class="text-[11px] text-slate-400 mt-1">10-point academic scale</p>
          </div>

          <!-- Graduation Year -->
          <div>
            <label for="grad_year" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Graduation Batch Year <span class="text-rose-500">*</span>
            </label>
            <input type="number" id="grad_year" name="grad_year" min="2000" max="2100" value="<%= student.grad_year || '' %>" required
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
              placeholder="e.g. 2026">
            <p class="text-[11px] text-slate-400 mt-1">Year of degree completion</p>
          </div>

          <!-- Resume Link -->
          <div class="sm:col-span-2">
            <label for="resume_url" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Online Resume / Portfolio Link
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i data-lucide="link" class="w-4 h-4"></i>
              </div>
              <input type="url" id="resume_url" name="resume_url" value="<%= student.resume_url || '' %>"
                class="w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
                placeholder="https://drive.google.com/... or https://linkedin.com/in/...">
            </div>
            <p class="text-[11px] text-slate-400 mt-1">Provide a shareable public link to your resume (PDF / Drive).</p>
          </div>

        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
          <a href="/student/dashboard" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            Cancel
          </a>
          <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition-colors flex items-center gap-2">
            <i data-lucide="save" class="w-4 h-4"></i>
            Save Profile Changes
          </button>
        </div>

      </form>
    </div>

  </main>

  <%- include('../partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
